---
import { getCollection } from "astro:content";
import ProjectDetailPage from "../../components/ProjectDetailPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ProjectEntry, ProjectSequenceLink } from "../../lib/projects";
import {
  getProjectInfoLines,
  getProjectSectionLinks,
  getResolvedProjectMedia,
  getHomepageProjects,
} from "../../lib/projects";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const selectedWorkProjects = getHomepageProjects(allProjects);
  const bottomSelectedWorkSlugs = [
    "soft-surveillance",
    "side-bag-with-embelishments",
    "two-friends-share-a-walk-at-night",
    "rectangle-with-embellishments",
    "black-union-jack",
    "lousy-t-shirt-8099e5",
  ];
  const selectedWorkProjectMap = new Map(allProjects.map((project) => [project.slug, project]));
  const bottomSelectedWorkProjects = bottomSelectedWorkSlugs
    .map((slug) => selectedWorkProjectMap.get(slug))
    .filter((project): project is (typeof allProjects)[number] => Boolean(project));
  const selectedWorkProjectsInOrder = [
    ...selectedWorkProjects,
    ...bottomSelectedWorkProjects.filter(
      (project) => !selectedWorkProjects.some((existing) => existing.slug === project.slug)
    ),
  ];

  return selectedWorkProjectsInOrder.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previousProject: {
        slug: selectedWorkProjectsInOrder[
          (index - 1 + selectedWorkProjectsInOrder.length) % selectedWorkProjectsInOrder.length
        ].slug,
        title:
          selectedWorkProjectsInOrder[
            (index - 1 + selectedWorkProjectsInOrder.length) % selectedWorkProjectsInOrder.length
          ].data.title,
        href: `/selected-work/${
          selectedWorkProjectsInOrder[
            (index - 1 + selectedWorkProjectsInOrder.length) % selectedWorkProjectsInOrder.length
          ].slug
        }/`,
      },
      nextProject: {
        slug: selectedWorkProjectsInOrder[(index + 1) % selectedWorkProjectsInOrder.length].slug,
        title:
          selectedWorkProjectsInOrder[(index + 1) % selectedWorkProjectsInOrder.length].data.title,
        href: `/selected-work/${
          selectedWorkProjectsInOrder[(index + 1) % selectedWorkProjectsInOrder.length].slug
        }/`,
      },
    },
  }));
}

interface Props {
  project: ProjectEntry;
  previousProject: ProjectSequenceLink;
  nextProject: ProjectSequenceLink;
}

const { project, previousProject, nextProject } = Astro.props;
const { Content } = await project.render();
const hasProjectBody =
  project.data.status !== "placeholder" && (project.body?.trim().length ?? 0) > 0;
const infoLines = getProjectInfoLines(project);
const media = getResolvedProjectMedia(project);
const sectionLinks = project.data.editorial.sections.includes("selected-work")
  ? getProjectSectionLinks(project, "selected-work")
  : getProjectSectionLinks(project, "mixed-media");
---

<BaseLayout
  title={`${project.data.title} | Daniel Oyegade`}
  description={project.data.descriptor}
  preloadImage={media.video?.poster ?? media.image}
>
  <ProjectDetailPage
    title={project.data.title}
    image={media.image}
    heroVideo={media.video}
    detailVideos={media.detailVideos}
    infoLines={infoLines}
    detailImages={media.detailImages}
    showBody={hasProjectBody}
    previousProject={previousProject}
    nextProject={nextProject}
    backLinkHref="/selected-work/"
    backLinkLabel="Selected Works"
    sectionLinks={sectionLinks}
  >
    {hasProjectBody && <Content />}
  </ProjectDetailPage>
</BaseLayout>
