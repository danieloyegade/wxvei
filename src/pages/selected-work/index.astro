---
import { getCollection } from "astro:content";
import SelectedWorkSequence from "../../components/SelectedWorkSequence.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mapProjectForGrid, sortProjectsByOrder } from "../../lib/projects";

const projects = sortProjectsByOrder(await getCollection("projects")).filter(
  (project) => project.data.status !== "mixed-media"
);
const selectedWorkProjects = projects.map(mapProjectForGrid);
---

<BaseLayout
  title="Selected Works | Daniel Oyegade"
  description="Selected work from the Daniel Oyegade portfolio."
>
  <SelectedWorkSequence projects={selectedWorkProjects} />
</BaseLayout>
