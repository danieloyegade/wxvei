---
import { getCollection } from "astro:content";
import ProjectDetailPage from "../../components/ProjectDetailPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ProjectEntry, ProjectSequenceLink } from "../../lib/projects";
import {
  getProjectInfoLines,
  getResolvedProjectMedia,
  getProjectSequenceFromSlugs,
  getProjectsBySlugs,
  portraitureProjectSlugs,
} from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const portraitureProjects = getProjectsBySlugs(projects, portraitureProjectSlugs);

  return portraitureProjects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      ...getProjectSequenceFromSlugs(
        projects,
        portraitureProjectSlugs,
        project.slug,
        "/portraiture/"
      ),
    },
  }));
}

interface Props {
  project: ProjectEntry;
  previousProject: ProjectSequenceLink;
  nextProject: ProjectSequenceLink;
}

const { project, previousProject, nextProject } = Astro.props;
const { Content } = await project.render();
const hasProjectBody = project.data.status !== "placeholder" && project.body.trim().length > 0;
const infoLines = getProjectInfoLines(project);
const media = getResolvedProjectMedia(project);
---

<BaseLayout
  title={`${project.data.title} | Daniel Oyegade`}
  description={project.data.descriptor}
  preloadImage={media.video?.poster ?? media.image}
>
  <ProjectDetailPage
    title={project.data.title}
    image={media.image}
    heroVideo={media.video}
    infoLines={infoLines}
    detailImages={media.detailImages}
    showBody={hasProjectBody}
    previousProject={previousProject}
    nextProject={nextProject}
    backLinkHref="/portraiture/"
    backLinkLabel="Portraiture"
  >
    {hasProjectBody && <Content />}
  </ProjectDetailPage>
</BaseLayout>
