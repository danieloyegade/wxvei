---
import { getCollection } from "astro:content";
import MixedMediaIntro from "../components/MixedMediaIntro.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySlugs,
  mapProjectForGrid,
  mixedMediaProjectSlugs,
  sortProjectsByOrder,
} from "../lib/projects";

const projects = getProjectsBySlugs(
  sortProjectsByOrder(await getCollection("projects")).filter(
    (project) => project.data.status === "mixed-media"
  ),
  mixedMediaProjectSlugs
);
---

<BaseLayout
  title="Mixed Media | Daniel Oyegade"
  description="A cross-disciplinary edit spanning image, moving image, and looser studies in texture, atmosphere, and form."
>
  <MixedMediaIntro
    eyebrow=""
    title="Mixed Media"
    summary="A cross-disciplinary edit spanning image, moving image, and looser studies in texture, atmosphere, and form."
  />
  <ProjectGrid
    sectionId="mixed-media"
    detailBasePath="/mixed-media/"
    projects={projects.map(mapProjectForGrid)}
  />
</BaseLayout>
