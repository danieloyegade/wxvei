---
import { getCollection } from "astro:content";
import ProjectGrid from "../components/ProjectGrid.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySection,
  mapProjectForGrid,
} from "../lib/projects";

const projects = getProjectsBySection(await getCollection("projects"), "mixed-media");
---

<BaseLayout
  title="Mixed Media | Daniel Oyegade"
  description={projectSectionConfigs["mixed-media"].description}
>
  <ProjectGrid
    sectionId="mixed-media"
    detailBasePath="/mixed-media/"
    projects={projects.map(mapProjectForGrid)}
  />
</BaseLayout>
