---
import { getCollection } from "astro:content";
import EditorialPageIntro from "../components/EditorialPageIntro.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySlugs,
  mapProjectForGrid,
  shortFilmProjectSlugs,
  sortProjectsByOrder,
} from "../lib/projects";

const projects = getProjectsBySlugs(
  sortProjectsByOrder(await getCollection("projects")),
  shortFilmProjectSlugs
);
---

<BaseLayout
  title="Short Films | Daniel Oyegade"
  description=""
>
  <EditorialPageIntro
    eyebrow="Curated Edit"
    title="Short Films"
    summary=""
  />
  <ProjectGrid detailBasePath="/short-films/" projects={projects.map(mapProjectForGrid)} />
</BaseLayout>
