---
import { getCollection } from "astro:content";
import ProjectGrid from "../components/ProjectGrid.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySection,
  mapProjectForGrid,
} from "../lib/projects";

const projects = getProjectsBySection(await getCollection("projects"), "short-films");
---

<BaseLayout
  title="Short Films | Daniel Oyegade"
  description={projectSectionConfigs["short-films"].description}
>
  <ProjectGrid
    sectionId="short-films"
    detailBasePath="/short-films/"
    projects={projects.map(mapProjectForGrid)}
  />
</BaseLayout>
