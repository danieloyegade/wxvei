---
import { getCollection } from "astro:content";
import EditorialPageIntro from "../components/EditorialPageIntro.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySection,
  mapProjectForGrid,
} from "../lib/projects";

const projects = getProjectsBySection(await getCollection("projects"), "short-films");
---

<BaseLayout
  title="Short Films | Daniel Oyegade"
  description=""
>
  <EditorialPageIntro
    eyebrow="Section"
    title="Short Films"
    summary=""
  />
  <ProjectGrid
    sectionId="short-films"
    detailBasePath="/short-films/"
    projects={projects.map(mapProjectForGrid)}
  />
</BaseLayout>
