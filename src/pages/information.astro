---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
---

<BaseLayout
  title="Information | Daniel Oyegade"
  description="Information about Daniel Oyegade and the editorial portfolio."
  preloadImage="/site/photos/daniel-oyegade.jpg"
>
  <section class="information-page">
    <div class="information-page__frame">
      <div class="information-page__grid">
        <figure class="information-page__portrait">
          <ResponsiveImage
            src="/site/photos/daniel-oyegade.jpg"
            alt="Daniel Oyegade"
            class="information-page__portrait-image"
            sizes="(min-width: 64rem) 50vw, 100vw"
            width="1284"
            height="1060"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>

        <div class="information-page__copy">
          <p class="information-page__lede">
            Daniel Oyegade is a photographer, filmmaker and visual artist working across
            portraiture, fashion imagery, moving image and mixed media. His work returns to
            Manchester and the North West, treating side streets, estates, municipal spaces and
            nocturnal architecture as stages.
          </p>

          <div class="information-page__bio">
            <p class="information-page__body">
              Drawing from folklore, postmodern theory, fashion imagery and everyday urban life,
              he makes small fictions out of ordinary scenes. He has worked with models connected
              to W Models, Neo Models, Nemesis Models, Brother Models and Milk Models, and is
              available for photography, moving image and creative direction.
            </p>

            <p class="information-page__body">
              Currently Manchester-based and relocating to London, he is familiar with medium
              format film as well as Canon, Nikon, Fuji and Sony digital systems, with Adobe Suite,
              Lightroom and Photoshop experience.
            </p>
          </div>

          <div class="information-page__facts" aria-label="Selected details">
            <div class="information-page__fact">
              <p class="information-page__fact-label">Available</p>
              <p class="information-page__fact-value">Photography, moving image and creative direction</p>
            </div>
            <div class="information-page__fact">
              <p class="information-page__fact-label">Based</p>
              <p class="information-page__fact-value">Manchester, relocating to London</p>
            </div>
            <div class="information-page__fact">
              <p class="information-page__fact-label">Format</p>
              <p class="information-page__fact-value">Medium format film, Canon, Nikon, Fuji and Sony</p>
            </div>
            <div class="information-page__fact">
              <p class="information-page__fact-label">Post</p>
              <p class="information-page__fact-value">Adobe Suite, Lightroom and Photoshop</p>
            </div>
          </div>

          <div class="information-page__meta" aria-label="Contact details">
            <div class="information-page__meta-block">
              <p class="information-page__meta-label">Contact</p>
              <a class="information-page__email" href="mailto:danieloyegadephoto@gmail.com">
                danieloyegadephoto@gmail.com
              </a>
            </div>

            <div class="information-page__meta-block" aria-label="Elsewhere">
              <p class="information-page__meta-label">Elsewhere
              
              </p>
              <a
                class="information-page__social-link"
                href="https://www.instagram.com/wxvei/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram - @wxvei
              </a>
            </div>
          </div>
        </div>
      </div>

      <section class="information-page__section" aria-labelledby="selected-press-heading">
        <div class="information-page__section-header">
          <p class="information-page__section-label">Recognition</p>
          <h2 id="selected-press-heading" class="information-page__section-title">
            Selected Press
          </h2>
        </div>

        <div class="information-page__press-list">
          <article class="information-page__press-card information-page__press-card--featured">
            <a
              class="information-page__press-preview"
              href="https://www.itsnicethat.com/articles/daniel-oyegade-photography-081221"
              target="_blank"
              rel="noreferrer noopener"
            >
              <img
                class="information-page__press-preview-image"
                src="/images/itsnicethat-daniel-oyegade.jpg"
                alt="Screenshot of It’s Nice That article about Daniel Oyegade"
                width="1024"
                height="752"
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="information-page__press-body">
              <p class="information-page__press-source">It’s Nice That</p>
              <h3 class="information-page__press-title">
                Daniel Oyegade’s striking photography is a visual love letter to Manchester’s urban
                spaces
              </h3>
              <p class="information-page__press-date">8 December 2021</p>
              <p class="information-page__press-summary">
                A profile of Daniel’s practice, tracing how philosophy, architecture and the city
                shape his considered way of seeing.
              </p>
              <a
                class="information-page__press-link"
                href="https://www.itsnicethat.com/articles/daniel-oyegade-photography-081221"
                target="_blank"
                rel="noreferrer noopener"
              >
                Read article
              </a>
            </div>
          </article>

          <article class="information-page__press-card information-page__press-card--text">
            <div class="information-page__press-body">
              <p class="information-page__press-source">Factory International</p>
              <h3 class="information-page__press-title">
                adidas Originals Creator Network North - 2026 Cohort
              </h3>
              <p class="information-page__press-summary">
                Part of the 2026 cohort. A six-month development programme for emerging creatives
                from Manchester and the North, offering time, support and creative development
                within the network.
              </p>
              <a
                class="information-page__press-link"
                href="https://factoryinternational.org/get-involved/adidas-originals-creator-network-north/2026-cohort/"
                target="_blank"
                rel="noreferrer noopener"
              >
                View cohort page
              </a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .information-page {
    padding: 1.15rem 1.5rem 8rem;
  }

  .information-page__frame {
    max-width: 96rem;
    margin: 0 auto;
    display: grid;
    gap: clamp(3rem, 4.4vw, 5rem);
  }

  .information-page__grid {
    display: grid;
    gap: 1.6rem;
  }

  .information-page__portrait {
    margin: 0;
    overflow: hidden;
    background: rgba(22, 20, 18, 0.05);
  }

  .information-page__portrait-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .information-page__copy {
    display: grid;
    gap: 1.15rem;
    max-width: 38rem;
  }

  .information-page__lede {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2.2vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.034em;
    line-height: 0.98;
    color: var(--page-foreground);
    text-wrap: balance;
  }

  .information-page__bio {
    display: grid;
    gap: 0.85rem;
  }

  .information-page__body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 0.84rem + 0.12vw, 0.99rem);
    line-height: 1.74;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .information-page__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
    padding-top: 0.25rem;
  }

  .information-page__fact {
    display: grid;
    gap: 0.35rem;
  }

  .information-page__fact-label,
  .information-page__section-label,
  .information-page__press-source,
  .information-page__meta-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--subtle-foreground);
  }

  .information-page__fact-value {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.88rem, 0.83rem + 0.1vw, 0.96rem);
    line-height: 1.55;
    color: var(--page-foreground);
  }

  .information-page__meta {
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .information-page__meta-block {
    display: grid;
    gap: 0.5rem;
  }

  .information-page__email {
    width: fit-content;
    font-family: var(--font-sans);
    font-size: clamp(0.92rem, 0.86rem + 0.12vw, 1rem);
    line-height: 1.55;
    color: var(--page-foreground);
    text-decoration: none;
  }

  .information-page__social-link {
    width: fit-content;
    font-family: var(--font-sans);
    font-size: clamp(0.92rem, 0.86rem + 0.12vw, 1rem);
    line-height: 1.55;
    color: var(--page-foreground);
    text-decoration-line: underline;
    text-decoration-color: rgba(22, 20, 18, 0.28);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color 160ms ease-out,
      text-decoration-color 160ms ease-out;
  }

  .information-page__social-link:hover,
  .information-page__social-link:focus-visible {
    color: var(--page-foreground);
    text-decoration-color: currentColor;
    outline: none;
  }

  .information-page__section {
    padding-top: 0.2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .information-page__section-header {
    display: grid;
    gap: 0.6rem;
    max-width: 28rem;
    margin-bottom: 1.45rem;
  }

  .information-page__section-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.95rem, 3.2vw, 3.1rem);
    font-weight: 500;
    letter-spacing: -0.038em;
    line-height: 0.96;
    color: var(--page-foreground);
    text-wrap: balance;
  }

  .information-page__press-list {
    display: grid;
    gap: 1.5rem;
  }

  .information-page__press-card {
    display: grid;
    gap: 1rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .information-page__press-preview {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(22, 20, 18, 0.04);
  }

  .information-page__press-preview-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .information-page__press-body {
    display: grid;
    gap: 0.55rem;
    max-width: 34rem;
  }

  .information-page__press-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1.75vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.02;
    color: var(--page-foreground);
    text-wrap: balance;
  }

  .information-page__press-date {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--subtle-foreground);
  }

  .information-page__press-summary {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 0.84rem + 0.12vw, 0.98rem);
    line-height: 1.68;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .information-page__press-link {
    width: fit-content;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--page-foreground);
    text-decoration: none;
    border-bottom: 1px solid rgba(22, 20, 18, 0.22);
    padding-bottom: 0.08rem;
  }

  @media (min-width: 40rem) {
    .information-page {
      padding: 1.7rem 2.5rem 10rem;
    }

    .information-page__press-card {
      gap: 1.1rem;
      padding-top: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .information-page__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
      gap: clamp(2rem, 3vw, 4rem);
    }

    .information-page__copy {
      padding-top: 0.35rem;
    }

    .information-page__press-card--featured {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      align-items: center;
      gap: clamp(1.25rem, 2vw, 2rem);
    }
  }

  @media (min-width: 80rem) {
    .information-page {
      padding-inline: 3.5rem;
    }
  }

  @media (max-width: 39.999rem) {
    .information-page__facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
