---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Information | Daniel Oyegade"
  description="Information about Daniel Oyegade and the editorial portfolio."
>
  <section class="px-6 pb-24 pt-28 sm:px-10 sm:pb-32 sm:pt-32 lg:px-14">
    <div class="mx-auto grid max-w-[96rem] gap-16 border-t border-black/8 pt-12 lg:grid-cols-[0.85fr_1.15fr] lg:pt-16">
      <div class="space-y-4">
        <p class="text-[0.68rem] uppercase tracking-[0.34em] text-[var(--muted-foreground)]">
          Information
        </p>
        <h1 class="max-w-md text-4xl leading-[0.96] tracking-[-0.04em] sm:text-6xl">
          Placeholder information page for Daniel Oyegade.
        </h1>
      </div>

      <div class="max-w-2xl space-y-10 text-sm leading-7 text-[var(--muted-foreground)] sm:text-[0.98rem] sm:leading-8">
        <p>
          Daniel Oyegade works across image, moving image, direction, and related editorial
          practice.
        </p>
        <p>
          Placeholder page rn , will later expand with a short statement, contact details, and
          supporting imagery.
        </p>
        <div class="grid gap-8 border-t border-black/8 pt-8 sm:grid-cols-2">
          <div>
            <p class="text-[0.68rem] uppercase tracking-[0.34em] text-[var(--subtle-foreground)]">Content</p>
            <p class="mt-3">Biography placeholder</p>
          </div>
          <div>
            <p class="text-[0.68rem] uppercase tracking-[0.34em] text-[var(--subtle-foreground)]">Contact</p>
            <p class="mt-3">hello@danieloyegade.com</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
