---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
---

<BaseLayout
  title="Information | Daniel Oyegade"
  description="Information about Daniel Oyegade and the editorial portfolio."
  preloadImage="/site/photos/daniel-oyegade.jpg"
>
  <section class="information-page">
    <div class="information-page__frame">
      <div class="information-page__grid">
        <figure class="information-page__portrait">
          <ResponsiveImage
            src="/site/photos/daniel-oyegade.jpg"
            alt="Daniel Oyegade"
            class="information-page__portrait-image"
            sizes="(min-width: 64rem) 50vw, 100vw"
            width="1284"
            height="1060"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>

        <div class="information-page__copy">
          <p class="information-page__lede">
            Daniel Oyegade works across image, moving image, direction, and related editorial
            practice.
          </p>

          <p class="information-page__body">
            For commissions, enquiries, and collaborations, get in touch below.
          </p>

          <div class="information-page__meta" aria-label="Contact details">
            <div class="information-page__meta-block">
              <p class="information-page__meta-label">Contact</p>
              <a class="information-page__email" href="mailto:danieloyegadephoto@gmail.com">
                danieloyegadephoto@gmail.com 
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .information-page {
    padding: 1.15rem 1.5rem 8rem;
  }

  .information-page__frame {
    max-width: 96rem;
    margin: 0 auto;
  }

  .information-page__grid {
    display: grid;
    gap: 1.6rem;
  }

  .information-page__portrait {
    margin: 0;
    overflow: hidden;
    background: rgba(22, 20, 18, 0.05);
  }

  .information-page__portrait-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .information-page__copy {
    display: grid;
    gap: 1.05rem;
    max-width: 34rem;
  }

  .information-page__lede {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2.2vw, 2.55rem);
    font-weight: 500;
    letter-spacing: -0.034em;
    line-height: 0.98;
    color: var(--page-foreground);
    text-wrap: balance;
  }

  .information-page__body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 0.84rem + 0.12vw, 0.99rem);
    line-height: 1.74;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .information-page__meta {
    padding-top: 1.05rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .information-page__meta-block {
    display: grid;
    gap: 0.5rem;
  }

  .information-page__meta-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--subtle-foreground);
  }

  .information-page__email {
    width: fit-content;
    font-family: var(--font-sans);
    font-size: clamp(0.92rem, 0.86rem + 0.12vw, 1rem);
    line-height: 1.55;
    color: var(--page-foreground);
    text-decoration: none;
  }

  @media (min-width: 40rem) {
    .information-page {
      padding: 1.7rem 2.5rem 10rem;
    }
  }

  @media (min-width: 64rem) {
    .information-page__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
      gap: clamp(2rem, 3vw, 4rem);
    }

    .information-page__copy {
      padding-top: 0.35rem;
    }
  }

  @media (min-width: 80rem) {
    .information-page {
      padding-inline: 3.5rem;
    }
  }
</style>
