---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Zealot of Harperhey | Daniel Oyegade"
  description="Zealot of Harperhey — an upcoming game by Daniel Oyegade. In development."
>
  <section class="zealot-page">
    <div class="zealot-page__frame">
      <div class="zealot-page__layout">
        <div class="zealot-page__stage">
          <div id="zealot-game-frame" class="zealot-page__game-frame">
            <!--
              Once a static build of the game is exported to
              public/games/zealot-of-harperhey/, replace this placeholder with:
              <iframe
                src={withBase("/games/zealot-of-harperhey/index.html")}
                title="Zealot of Harperhey"
                loading="lazy"
              ></iframe>
              Keep #zealot-game-frame's sizing rules below; the iframe only
              needs width: 100%; height: 100%; border: 0; display: block;
            -->
            <div class="zealot-page__placeholder">
              <p class="zealot-page__placeholder-text">Coming soon</p>
            </div>
          </div>
        </div>

        <aside class="zealot-page__info" aria-label="Project information">
          <div class="zealot-page__info-group">
            <p class="zealot-page__info-label">About</p>
            <p class="zealot-page__info-copy">
              Zealot of Harperhey is an upcoming game by Daniel Oyegade, currently in
              development. Final description to follow.
            </p>
          </div>

          <div class="zealot-page__info-group">
            <p class="zealot-page__info-label">Controls</p>
            <p class="zealot-page__info-copy zealot-page__info-copy--placeholder">
              Controls will be listed here once the game defines its input scheme.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .zealot-page {
    padding: 1.75rem 1.5rem 6rem;
  }

  .zealot-page__frame {
    max-width: min(92rem, calc(100vw - (var(--page-inline-padding) * 2)));
    margin: 0 auto;
  }

  .zealot-page__layout {
    display: grid;
    gap: 2.5rem;
  }

  .zealot-page__stage {
    display: flex;
    justify-content: center;
  }

  .zealot-page__game-frame {
    width: min(70vh, 70vw);
    aspect-ratio: 1 / 1;
    max-width: 100%;
    overflow: clip;
    background: rgba(20, 18, 16, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .zealot-page__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--page-foreground);
  }

  .zealot-page__placeholder-text {
    margin: 0;
    color: rgba(247, 243, 235, 0.86);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
  }

  .zealot-page__info {
    display: grid;
    gap: 1.6rem;
    max-width: 34rem;
    margin: 0 auto;
  }

  .zealot-page__info-group {
    display: grid;
    gap: 0.55rem;
  }

  .zealot-page__info-label {
    margin: 0;
    color: var(--subtle-foreground);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
  }

  .zealot-page__info-copy {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 0.84rem + 0.12vw, 0.99rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .zealot-page__info-copy--placeholder {
    color: var(--subtle-foreground);
    font-style: italic;
  }

  @media (min-width: 48rem) {
    .zealot-page {
      padding: 2.25rem 2.5rem 8rem;
    }

    .zealot-page__layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(15.5rem, 18.25rem);
      align-items: start;
      gap: 2.25rem;
    }

    .zealot-page__stage {
      justify-content: center;
    }

    .zealot-page__info {
      margin: 0;
      padding-top: 0.16rem;
    }
  }

  @media (min-width: 72rem) {
    .zealot-page {
      padding-inline: 3.5rem;
    }
  }
</style>
