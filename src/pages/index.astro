---
import { getCollection, getEntry } from "astro:content";
import SelectedWorkSequence from "../components/SelectedWorkSequence.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSelectedWorkSequenceProjects } from "../lib/projects";

const selectedWorkOrder = await getEntry("selectedWorkOrder", "selected-works");

if (!selectedWorkOrder) {
  throw new Error(
    'Missing selected work order file at "src/content/selectedWorkOrder/selected-works.md".'
  );
}

const selectedWorkProjects = getSelectedWorkSequenceProjects(
  await getCollection("projects"),
  selectedWorkOrder.data.beats
);
---

<BaseLayout
  title="Selected Works | Daniel Oyegade"
  description={projectSectionConfigs["selected-work"].description}
>
  <SelectedWorkSequence projects={selectedWorkProjects} />
</BaseLayout>
