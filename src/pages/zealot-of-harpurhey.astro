---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Zealot of Harpurhey | Daniel Oyegade"
  description="Zealot of Harpurhey — an upcoming game by Daniel Oyegade. In development."
>
  <section class="zealot-page">
    <div class="zealot-page__frame">
      <div class="zealot-page__stage">
        <div id="zealot-game-frame" class="zealot-page__game-frame">
          <iframe
            src="https://game.danieloye.com/"
            title="Zealot of Harpurhey"
            loading="lazy"
            allow="autoplay; fullscreen"
          ></iframe>
        </div>
      </div>

      <div class="zealot-page__info" aria-label="Project information">
        <div class="zealot-page__info-group">
          <p class="zealot-page__info-label">About</p>
          <p class="zealot-page__info-copy">
            Zealot of Harpurhey is an upcoming game by Daniel Oyegade, currently in
            development. Final description to follow.
          </p>
        </div>

        <div class="zealot-page__info-group">
          <p class="zealot-page__info-label">Controls</p>

          <div class="zealot-page__controls">
            <p class="zealot-page__controls-heading">On foot</p>
            <ul class="zealot-page__controls-list">
              <li><span class="zealot-page__key">WASD / Arrow keys</span>move</li>
              <li><span class="zealot-page__key">Shift or Space</span>run</li>
              <li><span class="zealot-page__key">Pointer drag</span>orbit camera</li>
              <li><span class="zealot-page__key">C</span>recenter camera</li>
              <li><span class="zealot-page__key">E</span>contextual action</li>
            </ul>
          </div>

          <div class="zealot-page__controls">
            <p class="zealot-page__controls-heading">On a bike</p>
            <ul class="zealot-page__controls-list">
              <li><span class="zealot-page__key">W</span>pedal</li>
              <li><span class="zealot-page__key">Shift</span>assist</li>
              <li><span class="zealot-page__key">Space</span>boost</li>
              <li><span class="zealot-page__key">A / D</span>steer</li>
              <li><span class="zealot-page__key">S</span>brake</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .zealot-page {
    padding: 1.75rem 1.5rem 6rem;
  }

  .zealot-page__frame {
    max-width: min(92rem, calc(100vw - (var(--page-inline-padding) * 2)));
    margin: 0 auto;
  }

  .zealot-page__stage {
    display: grid;
    justify-items: center;
  }

  .zealot-page__game-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: clip;
    background: #000;
  }

  .zealot-page__game-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .zealot-page__info {
    display: grid;
    gap: 1.75rem;
    max-width: 40rem;
    margin: 2rem auto 0;
  }

  .zealot-page__info-group {
    display: grid;
    gap: 0.55rem;
  }

  .zealot-page__info-label {
    margin: 0;
    color: var(--subtle-foreground);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
  }

  .zealot-page__info-copy {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 0.84rem + 0.12vw, 0.99rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .zealot-page__info-copy--placeholder {
    color: var(--subtle-foreground);
    font-style: italic;
  }

  .zealot-page__controls {
    display: grid;
    gap: 0.5rem;
  }

  .zealot-page__controls + .zealot-page__controls {
    margin-top: 0.4rem;
  }

  .zealot-page__controls-heading {
    margin: 0;
    color: var(--page-foreground);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .zealot-page__controls-list {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zealot-page__controls-list li {
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: clamp(0.85rem, 0.8rem + 0.1vw, 0.92rem);
    line-height: 1.5;
  }

  .zealot-page__key {
    display: inline-block;
    min-width: 8.5rem;
    margin-right: 0.5rem;
    color: var(--page-foreground);
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .zealot-page {
      padding: 2.25rem 2.5rem 8rem;
    }

    .zealot-page__info {
      margin-top: 2.5rem;
    }
  }

  @media (min-width: 72rem) {
    .zealot-page {
      padding-inline: 3.5rem;
    }
  }
</style>
