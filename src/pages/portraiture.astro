---
import { getCollection } from "astro:content";
import EditorialPageIntro from "../components/EditorialPageIntro.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySlugs,
  mapProjectForGrid,
  portraitureProjectSlugs,
  sortProjectsByOrder,
} from "../lib/projects";

const projects = getProjectsBySlugs(
  sortProjectsByOrder(await getCollection("projects")),
  portraitureProjectSlugs
);
---

<BaseLayout
  title="Portraiture | Daniel Oyegade"
  description=""
>
  <EditorialPageIntro
    eyebrow=""
    title="Portraiture"
    summary=""
  />
  <ProjectGrid detailBasePath="/portraiture/" projects={projects.map(mapProjectForGrid)} />
</BaseLayout>
