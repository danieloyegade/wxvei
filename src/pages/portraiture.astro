---
import { getCollection } from "astro:content";
import ProjectGrid from "../components/ProjectGrid.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getProjectsBySection,
  mapProjectForGrid,
} from "../lib/projects";

const projects = getProjectsBySection(await getCollection("projects"), "portraiture");
---

<BaseLayout
  title="Portraiture | Daniel Oyegade"
  description={projectSectionConfigs.portraiture.description}
>
  <ProjectGrid
    sectionId="portraiture"
    detailBasePath="/portraiture/"
    projects={projects.map(mapProjectForGrid)}
  />
</BaseLayout>
