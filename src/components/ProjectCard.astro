---
import ResponsiveImage from "./ResponsiveImage.astro";
import type { ProjectHoverPreview, ProjectVideoAsset } from "../lib/projects";
import { projectPath } from "../lib/projects";
import { getResponsiveImageFallbackSrc } from "../lib/responsiveImages";
import { withBase } from "../lib/site";

interface Props {
  slug: string;
  title: string;
  image: string;
  descriptor: string;
  video?: ProjectVideoAsset;
  hoverPreview?: ProjectHoverPreview;
  href?: string;
  indexLabel?: string;
  layoutClass: string;
  frameClass: string;
  frameStyle?: string;
  cropFocus?: "center" | "top" | "upper-third";
  visualWeight?: "support" | "standard" | "dominant" | "hero";
  cardClassName?: string;
  priority?: boolean;
}

const {
  slug,
  title,
  image,
  descriptor,
  video,
  hoverPreview,
  href = projectPath(slug),
  indexLabel,
  layoutClass,
  frameClass,
  frameStyle,
  cropFocus = "center",
  visualWeight = "standard",
  cardClassName,
  priority = false,
} = Astro.props;

const objectPositionMap = {
  center: "center center",
  top: "center top",
  "upper-third": "center 28%",
} as const;

const previewVideoSrc = hoverPreview?.src ?? video?.src;
const previewVideoType = previewVideoSrc?.toLowerCase().endsWith(".mp4")
  ? "video/mp4"
  : previewVideoSrc?.toLowerCase().endsWith(".mov")
    ? "video/quicktime"
    : undefined;
const playsPreviewInView = video?.playInView ?? false;
const isVideoFirst = video?.videoFirst ?? false;
const previewPoster = getResponsiveImageFallbackSrc(hoverPreview?.poster ?? video?.poster ?? image);
const hasPreview = Boolean(previewVideoSrc && (hoverPreview || playsPreviewInView || isVideoFirst));
const rendersImage = Boolean(image);
const imageSizes = "(min-width: 80rem) 50vw, (min-width: 48rem) 50vw, 100vw";
const imageLoading = priority ? "eager" : "lazy";
const imageFetchPriority = priority ? "high" : undefined;
const imageClass = [
  "project-card__image",
  hasPreview ? "project-card__image--has-preview" : "",
].filter(Boolean).join(" ");
---

<article
  class:list={["project-card", layoutClass, cardClassName]}
  data-project-card
  data-project-slug={slug}
  data-preview-in-view={playsPreviewInView ? "true" : undefined}
  data-card-media={isVideoFirst ? "video-first" : "image-first"}
  data-visual-weight={visualWeight}
>
  <a class="project-card__link" href={href} aria-label={`View ${title}`}>
    <div
      class:list={["project-card__image-wrap", frameClass]}
      style={frameStyle}
      data-project-reveal
      data-reveal-state="pending"
    >
      {rendersImage && (
        <ResponsiveImage
          src={image}
          alt={title}
          class={imageClass}
          fill={true}
          style={`object-position: ${objectPositionMap[cropFocus]}; object-fit: cover;`}
          sizes={imageSizes}
          loading={imageLoading}
          decoding="async"
          fetchpriority={imageFetchPriority}
        />
      )}
      {hasPreview && (
        <video
          class="project-card__preview"
          muted
          playsinline
          webkit-playsinline="true"
          disablepictureinpicture
          disableremoteplayback
          preload="none"
          poster={encodeURI(withBase(previewPoster))}
          aria-hidden="true"
          data-project-preview
          data-preview-start={hoverPreview?.startTime}
          data-preview-end={hoverPreview?.endTime}
        >
          <source src={encodeURI(withBase(previewVideoSrc!))} type={previewVideoType} />
        </video>
      )}
      <div class="project-card__overlay"></div>
      <div class="project-card__hover-copy">
        <h2 class="project-card__hover-title">{title}</h2>
        <p class="project-card__hover-descriptor">{descriptor}</p>
      </div>
    </div>
  </a>
  {indexLabel && (
    <div class="project-card__meta">
      <p class="project-card__index">{indexLabel}</p>
    </div>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
    min-width: 0;
  }

  .project-card__link {
    display: block;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .project-card__image-wrap {
    position: relative;
    overflow: hidden;
    background: rgba(22, 20, 18, 0.05);
    opacity: 0.84;
    transform: translate3d(0, 0.16rem, 0);
    transition:
      opacity 480ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .project-card__image-wrap[data-reveal-state="visible"] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .project-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 420ms ease-out,
      opacity 220ms ease-out;
  }

  .project-card__preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 420ms ease-out,
      opacity 220ms ease-out;
  }

  .project-card[data-preview-active="true"] .project-card__preview {
    opacity: 1;
  }

  .project-card[data-card-media="video-first"][data-preview-ready="true"] .project-card__preview {
    opacity: 1;
  }

  .project-card[data-preview-active="true"] .project-card__image--has-preview {
    opacity: 0;
  }

  .project-card[data-card-media="video-first"][data-preview-ready="true"] .project-card__image--has-preview {
    opacity: 0;
  }

  .project-card[data-preview-disabled="true"] .project-card__preview {
    opacity: 0;
  }

  .project-card[data-preview-disabled="true"] .project-card__image--has-preview {
    opacity: 1;
  }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 12, 11, 0.54) 0%,
      rgba(13, 12, 11, 0.3) 24%,
      rgba(13, 12, 11, 0) 58%
    );
    opacity: 0;
    transition: opacity 260ms ease-out;
    pointer-events: none;
  }

  .project-card__hover-copy {
    position: absolute;
    right: clamp(0.95rem, 1.1vw, 1.35rem);
    bottom: clamp(0.95rem, 1.1vw, 1.3rem);
    left: clamp(0.95rem, 1.1vw, 1.35rem);
    z-index: 1;
    display: grid;
    gap: 0.18rem;
    max-width: min(26rem, 78%);
    opacity: 0;
    transform: translate3d(0, 0.35rem, 0);
    transition: opacity 220ms ease-out, transform 220ms ease-out;
    pointer-events: none;
  }

  .project-card__hover-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.45vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 0.95;
    color: rgba(247, 243, 235, 0.98);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    text-wrap: balance;
  }

  .project-card__hover-descriptor {
    margin: 0.02rem 0 0;
    font-family: var(--font-sans);
    max-width: 26ch;
    font-size: clamp(0.7rem, 0.66rem + 0.12vw, 0.78rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.35;
    color: rgba(247, 243, 235, 0.76);
    text-transform: none;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 0.85rem;
  }

  .project-card__index {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-transform: uppercase;
    color: rgba(64, 58, 52, 0.74);
    white-space: nowrap;
  }

  .project-card:hover .project-card__image,
  .project-card:hover .project-card__preview,
  .project-card:focus-within .project-card__image,
  .project-card:focus-within .project-card__preview {
    filter: brightness(0.95);
    transform: scale(1.006);
  }

  .project-card__link:focus-visible {
    outline: none;
  }

  .project-card__link:focus-visible .project-card__image-wrap {
    box-shadow: 0 0 0 1px rgba(18, 16, 13, 0.18);
  }

  .project-card:hover .project-card__overlay,
  .project-card:focus-within .project-card__overlay {
    opacity: 0.84;
  }

  .project-card:hover .project-card__hover-copy,
  .project-card:focus-within .project-card__hover-copy {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .project-card:hover .project-card__hover-descriptor,
  .project-card:focus-within .project-card__hover-descriptor {
    color: rgba(247, 243, 235, 0.88);
  }

  @media (hover: none), (pointer: coarse) {
    .project-card__overlay {
      opacity: 0.76;
    }

    .project-card__hover-copy {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    .project-card__hover-descriptor {
      color: rgba(247, 243, 235, 0.84);
    }
  }

  @media (max-width: 40rem) {
    .project-card--section-grid {
      gap: 0.88rem;
    }

    .project-card--mobile-inset-start,
    .project-card--mobile-inset-end {
      width: min(100%, calc(100% - 2.4rem));
    }

    .project-card--mobile-inset-start {
      justify-self: start;
    }

    .project-card--mobile-inset-end {
      justify-self: end;
    }

    .project-card--mobile-pause {
      margin-top: 0.8rem;
    }

    .project-card--section-grid .project-card__hover-copy {
      right: 0.88rem;
      bottom: 0.88rem;
      left: 0.88rem;
      gap: 0.22rem;
      max-width: min(18rem, 76%);
    }

    .project-card--section-grid .project-card__hover-title {
      font-size: clamp(1.14rem, 5.2vw, 1.42rem);
    }

    .project-card--section-grid .project-card__hover-descriptor {
      max-width: 22ch;
      font-size: 0.74rem;
      line-height: 1.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__image-wrap {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .project-card__image,
    .project-card__preview {
      transition: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const prefersReducedData = Boolean(navigator.connection?.saveData);
  const supportsHoverPlayback = window.matchMedia("(hover: hover) and (pointer: fine)");

  const setPreviewTime = (preview, startTime) => {
    if (!Number.isFinite(startTime) || preview.readyState < 1) return;

    try {
      preview.currentTime = startTime;
    } catch {
      // Ignore timing updates until the browser allows seeking.
    }
  };

  const handlePlaybackPromise = (playbackPromise, onError) => {
    if (typeof playbackPromise?.catch === "function") {
      playbackPromise.catch(onError);
    }
  };

  document.querySelectorAll("[data-project-card]").forEach((card) => {
    if (!(card instanceof HTMLElement) || card.dataset.previewBound === "true") return;

    const preview = card.querySelector("[data-project-preview]");

    if (!(preview instanceof HTMLVideoElement)) return;

    card.dataset.previewBound = "true";

    const startTime = Number(preview.dataset.previewStart ?? "0");
    const playsInView = card.dataset.previewInView === "true";
    const canAutoplayInView =
      playsInView &&
      supportsHoverPlayback.matches &&
      !prefersReducedMotion.matches &&
      !prefersReducedData;
    const previewEnd = preview.dataset.previewEnd;
    const endTime =
      previewEnd !== undefined && previewEnd !== ""
        ? Number(previewEnd)
        : null;
    const playbackEnd = endTime ?? Number.POSITIVE_INFINITY;
    let isHovered = false;
    let isFocusedWithin = false;
    let isVisibleInViewport = false;
    let hasAutoplayStarted = false;
    let hasCompletedPlayback = false;
    let pendingPlay = false;

    const isInteractionActive = () => isHovered || isFocusedWithin;
    const shouldPlayPreview = () =>
      card.dataset.previewDisabled !== "true" &&
      !document.hidden &&
      (
        isInteractionActive() ||
        (canAutoplayInView && isVisibleInViewport && hasAutoplayStarted && !hasCompletedPlayback)
      );

    const primePreview = () => {
      if (card.dataset.previewPrimed === "true" || card.dataset.previewDisabled === "true") return;

      card.dataset.previewPrimed = "true";
      preview.muted = true;
      preview.defaultMuted = true;
      preview.playsInline = true;
      preview.preload = playsInView ? "auto" : "metadata";
      preview.load();
    };

    const stopPreview = () => {
      pendingPlay = false;
      card.dataset.previewActive = "false";
      preview.pause();
    };

    const resetPreview = () => {
      setPreviewTime(preview, startTime);
      hasCompletedPlayback = false;
    };

    const finishPreviewPlayback = () => {
      pendingPlay = false;
      hasCompletedPlayback = true;
      card.dataset.previewActive = "false";
      preview.pause();
    };

    const playPreview = () => {
      preview.muted = true;
      preview.defaultMuted = true;
      preview.playsInline = true;
      const playbackPromise = preview.play();

      handlePlaybackPromise(playbackPromise, () => {
        card.dataset.previewActive = "false";
      });
    };

    const startPreview = ({ restart = false } = {}) => {
      if (card.dataset.previewDisabled === "true") return;

      pendingPlay = true;
      primePreview();

      if (preview.readyState < 2) {
        return;
      }

      if (
        restart ||
        preview.currentTime < startTime ||
        preview.currentTime >= playbackEnd
      ) {
        resetPreview();
      }

      playPreview();
    };

    const syncPreviewState = ({ restart = false, resetTimeOnStop = true } = {}) => {
      if (shouldPlayPreview()) {
        startPreview({ restart });
        return;
      }

      stopPreview();

      if (resetTimeOnStop) {
        resetPreview();
      }
    };

    const handleCanPlay = () => {
      if (!pendingPlay || !shouldPlayPreview()) return;

      if (preview.currentTime < startTime || preview.currentTime >= playbackEnd) {
        resetPreview();
      }

      playPreview();
    };

    const handleMouseEnter = () => {
      isHovered = true;
      syncPreviewState({ restart: true });
    };

    const handleMouseLeave = () => {
      isHovered = false;
      syncPreviewState({ resetTimeOnStop: !hasAutoplayStarted });
    };

    const handleFocusIn = () => {
      isFocusedWithin = true;
      syncPreviewState({ restart: true });
    };

    const handleFocusOut = (event) => {
      const nextTarget = event.relatedTarget;

      if (nextTarget instanceof Node && card.contains(nextTarget)) return;

      isFocusedWithin = false;
      syncPreviewState({ resetTimeOnStop: !hasAutoplayStarted });
    };

    preview.addEventListener("canplay", handleCanPlay);

    preview.addEventListener("loadedmetadata", () => {
      card.dataset.previewReady = "true";
      setPreviewTime(preview, startTime);
    });

    preview.addEventListener("playing", () => {
      if (!shouldPlayPreview()) return;

      card.dataset.previewActive = "true";
    });

    preview.addEventListener("waiting", () => {
      if (!pendingPlay) return;

      card.dataset.previewActive = "false";
    });

    preview.addEventListener("timeupdate", () => {
      if (endTime === null || preview.paused || preview.currentTime < endTime) return;

      finishPreviewPlayback();
    });

    preview.addEventListener("ended", () => {
      finishPreviewPlayback();
    });

    preview.addEventListener("error", () => {
      card.dataset.previewDisabled = "true";
      delete card.dataset.previewReady;
      stopPreview();
      resetPreview();
    });

    card.addEventListener("mouseenter", handleMouseEnter);
    card.addEventListener("mouseleave", handleMouseLeave);
    card.addEventListener("focusin", handleFocusIn);
    card.addEventListener("focusout", handleFocusOut);

    if ("IntersectionObserver" in window) {
      const visibilityObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.target !== card) return;

            if (entry.isIntersecting && !prefersReducedData) {
              primePreview();
            }

            isVisibleInViewport = entry.isIntersecting && entry.intersectionRatio >= 0.35;

            if (canAutoplayInView && isVisibleInViewport && !hasAutoplayStarted) {
              hasAutoplayStarted = true;
            }

            syncPreviewState({ restart: isVisibleInViewport, resetTimeOnStop: false });

            if (!canAutoplayInView && card.dataset.previewPrimed === "true") {
              observer.unobserve(card);
            }
          });
        },
        {
          threshold: [0, 0.01, 0.2, 0.35, 0.6],
          rootMargin: "20% 0px 20% 0px",
        }
      );

      visibilityObserver.observe(card);
    } else if (canAutoplayInView) {
      primePreview();
      isVisibleInViewport = true;
      hasAutoplayStarted = true;
      syncPreviewState({ restart: true, resetTimeOnStop: false });
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopPreview();
        return;
      }

      syncPreviewState({ resetTimeOnStop: false });
    });
  });
</script>
