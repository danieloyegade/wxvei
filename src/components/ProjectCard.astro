---
import { projectPath } from "../lib/projects";
import { withBase } from "../lib/site";

interface Props {
  slug: string;
  title: string;
  image: string;
  descriptor: string;
  href?: string;
  indexLabel?: string;
  layoutClass: string;
  frameClass: string;
  cropFocus?: "center" | "top" | "upper-third";
  visualWeight?: "support" | "standard" | "dominant" | "hero";
}

const {
  slug,
  title,
  image,
  descriptor,
  href = projectPath(slug),
  indexLabel,
  layoutClass,
  frameClass,
  cropFocus = "center",
  visualWeight = "standard",
} = Astro.props;

const objectPositionMap = {
  center: "center center",
  top: "center top",
  "upper-third": "center 28%",
} as const;
---

<article
  class:list={["project-card", layoutClass]}
  data-project-slug={slug}
  data-visual-weight={visualWeight}
>
  <a class="project-card__link" href={href} aria-label={`View ${title}`}>
    <div class:list={["project-card__image-wrap", frameClass]} data-project-reveal data-reveal-state="pending">
      <div class="project-card__overlay"></div>
      <img
        src={encodeURI(withBase(image))}
        alt={title}
        class="project-card__image"
        style={`object-position: ${objectPositionMap[cropFocus]}; object-fit: cover;`}
        loading="lazy"
        decoding="async"
      />
      <div class="project-card__hover-copy">
        <h2 class="project-card__hover-title">{title}</h2>
        <p class="project-card__hover-descriptor">{descriptor}</p>
      </div>
    </div>
  </a>
  {indexLabel && (
    <div class="project-card__meta">
      <p class="project-card__index">{indexLabel}</p>
    </div>
  )}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
    min-width: 0;
  }

  .project-card__link {
    display: block;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .project-card__image-wrap {
    position: relative;
    overflow: hidden;
    background: rgba(22, 20, 18, 0.05);
    opacity: 0.84;
    transform: translate3d(0, 0.16rem, 0);
    transition:
      opacity 480ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .project-card__image-wrap[data-reveal-state="visible"] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 420ms ease-out;
  }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 12, 11, 0.54) 0%,
      rgba(13, 12, 11, 0.3) 24%,
      rgba(13, 12, 11, 0) 58%
    );
    opacity: 0;
    transition: opacity 260ms ease-out;
    pointer-events: none;
  }

  .project-card__hover-copy {
    position: absolute;
    right: clamp(0.95rem, 1.1vw, 1.35rem);
    bottom: clamp(0.95rem, 1.1vw, 1.3rem);
    left: clamp(0.95rem, 1.1vw, 1.35rem);
    z-index: 1;
    display: grid;
    gap: 0.18rem;
    max-width: min(26rem, 78%);
    opacity: 0;
    transform: translate3d(0, 0.35rem, 0);
    transition: opacity 220ms ease-out, transform 220ms ease-out;
    pointer-events: none;
  }

  .project-card__hover-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.45vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 0.95;
    color: rgba(247, 243, 235, 0.98);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    text-wrap: balance;
  }

  .project-card__hover-descriptor {
    margin: 0.02rem 0 0;
    font-family: var(--font-sans);
    max-width: 26ch;
    font-size: clamp(0.7rem, 0.66rem + 0.12vw, 0.78rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.35;
    color: rgba(247, 243, 235, 0.76);
    text-transform: none;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 0.85rem;
  }

  .project-card__index {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-transform: uppercase;
    color: rgba(64, 58, 52, 0.74);
    white-space: nowrap;
  }

  .project-card:hover .project-card__image,
  .project-card:focus-within .project-card__image {
    filter: brightness(0.95);
    transform: scale(1.006);
  }

  .project-card__link:focus-visible {
    outline: none;
  }

  .project-card__link:focus-visible .project-card__image-wrap {
    box-shadow: 0 0 0 1px rgba(18, 16, 13, 0.18);
  }

  .project-card:hover .project-card__overlay,
  .project-card:focus-within .project-card__overlay {
    opacity: 0.84;
  }

  .project-card:hover .project-card__hover-copy,
  .project-card:focus-within .project-card__hover-copy {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .project-card:hover .project-card__hover-descriptor,
  .project-card:focus-within .project-card__hover-descriptor {
    color: rgba(247, 243, 235, 0.88);
  }

  @media (hover: none), (pointer: coarse) {
    .project-card__overlay {
      opacity: 0.76;
    }

    .project-card__hover-copy {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    .project-card__hover-descriptor {
      color: rgba(247, 243, 235, 0.84);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__image-wrap {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
