---
import { getCollection } from "astro:content";
import SelectedWorkEditorialSequence from "./SelectedWorkEditorialSequence.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomepageProjects, mapProjectForGrid } from "../lib/projects";

const projects = getHomepageProjects(await getCollection("projects"));
const selectedWorkProjects = projects.map(mapProjectForGrid);
const winterNotesSlug = "Winter notes";
const reorderedSelectedWorkSlugs = [
  "weng-u",
  "george-for-imm-models",
  "moses-for-amber-mather",
];

const winterNotesIndex = selectedWorkProjects.findIndex(({ slug }) => slug === winterNotesSlug);

const selectedWorkProjectsInOrder =
  winterNotesIndex === -1
    ? selectedWorkProjects
    : [
        ...selectedWorkProjects.slice(0, winterNotesIndex + 1),
        ...reorderedSelectedWorkSlugs
          .map((slug) => selectedWorkProjects.find((project) => project.slug === slug))
          .filter((project): project is (typeof selectedWorkProjects)[number] => Boolean(project)),
        ...selectedWorkProjects.slice(winterNotesIndex + 1).filter(
          (project) => !reorderedSelectedWorkSlugs.includes(project.slug)
        ),
      ];
const preloadImage =
  selectedWorkProjectsInOrder[0]?.video?.poster ?? selectedWorkProjectsInOrder[0]?.image;
---

<BaseLayout
  title="Selected Works | Daniel Oyegade"
  description={projectSectionConfigs["selected-work"].description}
  preloadImage={preloadImage}
>
  <SelectedWorkEditorialSequence projects={selectedWorkProjectsInOrder} />
</BaseLayout>
