---
import { getCollection } from "astro:content";
import SelectedWorkEditorialSequence from "./SelectedWorkEditorialSequence.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomepageProjects, mapProjectForGrid } from "../lib/projects";

const projects = getHomepageProjects(await getCollection("projects"));
const selectedWorkProjects = projects.map(mapProjectForGrid);
const preloadImage = selectedWorkProjects[0]?.video?.poster ?? selectedWorkProjects[0]?.image;
---

<BaseLayout
  title="Selected Works | Daniel Oyegade"
  description={projectSectionConfigs["selected-work"].description}
  preloadImage={preloadImage}
>
  <SelectedWorkEditorialSequence projects={selectedWorkProjects} />
</BaseLayout>
