---
import { getCollection } from "astro:content";
import SelectedWorkEditorialSequence from "./SelectedWorkEditorialSequence.astro";
import { projectSectionConfigs } from "../data/editorial";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomepageProjects, mapProjectForGrid } from "../lib/projects";

const allProjects = await getCollection("projects");
const projects = getHomepageProjects(allProjects);
const selectedWorkProjects = projects.map(mapProjectForGrid);
const bottomSelectedWorkSlugs = [
  "soft-surveillance",
  "side-bag-with-embelishments",
  "two-friends-share-a-walk-at-night",
  "rectangle-with-embellishments",
  "black-union-jack",
];
const selectedWorkProjectMap = new Map(allProjects.map((project) => [project.slug, project]));
const bottomSelectedWorkProjects = bottomSelectedWorkSlugs
  .map((slug) => selectedWorkProjectMap.get(slug))
  .filter((project): project is (typeof projects)[number] => Boolean(project))
  .map(mapProjectForGrid);
const winterNotesSlug = "Winter notes";
const reorderedSelectedWorkSlugs = [
  "weng-u",
  "george-for-imm-models",
  "moses-for-amber-mather",
];

const winterNotesIndex = selectedWorkProjects.findIndex(({ slug }) => slug === winterNotesSlug);

const selectedWorkProjectsInOrder =
  winterNotesIndex === -1
    ? selectedWorkProjects
    : [
        ...selectedWorkProjects.slice(0, winterNotesIndex + 1),
        ...reorderedSelectedWorkSlugs
          .map((slug) => selectedWorkProjects.find((project) => project.slug === slug))
          .filter((project): project is (typeof selectedWorkProjects)[number] => Boolean(project)),
        ...selectedWorkProjects.slice(winterNotesIndex + 1).filter(
          (project) => !reorderedSelectedWorkSlugs.includes(project.slug)
        ),
      ];
const selectedWorkProjectsWithBottomAppend = [
  ...selectedWorkProjectsInOrder,
  ...bottomSelectedWorkProjects.filter(
    (project) => !selectedWorkProjectsInOrder.some((existing) => existing.slug === project.slug)
  ),
];
const preloadImage =
  selectedWorkProjectsWithBottomAppend[0]?.video?.poster ??
  selectedWorkProjectsWithBottomAppend[0]?.image;
---

<BaseLayout
  title="Selected Works | Daniel Oyegade"
  description={projectSectionConfigs["selected-work"].description}
  preloadImage={preloadImage}
>
  <SelectedWorkEditorialSequence projects={selectedWorkProjectsWithBottomAppend} />
</BaseLayout>
