---
import ProjectCard from "./ProjectCard.astro";
import type {
  ProjectHomepagePlacement,
  ProjectHoverPreview,
  ProjectVideoAsset,
} from "../lib/projects";
import { projectFrameClasses } from "../lib/projectLayout";
import type {
  ProjectCropFocus,
  ProjectOrientation,
  ProjectVisualWeight,
} from "../lib/projectLayout";

interface SelectedWorkProject {
  slug: string;
  title: string;
  image: string;
  descriptor: string;
  cursorInfo?: string[];
  video?: ProjectVideoAsset;
  hoverPreview?: ProjectHoverPreview;
  visualWeight?: ProjectVisualWeight;
  orientation?: ProjectOrientation;
  selectedWorkAspectRatio?: string;
  cropFocus?: ProjectCropFocus;
  homepage?: ProjectHomepagePlacement;
  priority?: boolean;
}

interface Props {
  projects: SelectedWorkProject[];
}

const { projects } = Astro.props as Props;

const beatTemplates = {
  opening: {
    className: "selected-work-sequence__beat--opening",
    layoutClasses: [
      "col-span-12 md:col-span-8 md:col-start-1 xl:col-span-8 xl:col-start-1",
      "col-span-12 md:col-span-3 md:col-start-10 md:mt-14 xl:col-span-3 xl:col-start-10 xl:mt-20",
    ],
  },
  reverse: {
    className: "selected-work-sequence__beat--reverse",
    layoutClasses: [
      "col-span-12 md:col-span-3 md:col-start-1 md:mt-8 xl:col-span-3 xl:col-start-1 xl:mt-12",
      "col-span-12 md:col-span-8 md:col-start-5 xl:col-span-8 xl:col-start-5",
    ],
  },
  balanced: {
    className: "selected-work-sequence__beat--balanced",
    layoutClasses: [
      "col-span-12 md:col-span-4 md:col-start-1 xl:col-span-4 xl:col-start-1",
      "col-span-12 md:col-span-6 md:col-start-7 md:mt-8 xl:col-span-6 xl:col-start-7 xl:mt-12",
    ],
  },
  split: {
    className: "selected-work-sequence__beat--split",
    layoutClasses: [
      "col-span-12 md:col-span-4 md:col-start-2 xl:col-span-4 xl:col-start-2",
      "col-span-12 md:col-span-7 md:col-start-6 md:mt-10 xl:col-span-7 xl:col-start-6 xl:mt-14",
    ],
  },
  solo: {
    className: "selected-work-sequence__beat--solo",
    layoutClasses: ["col-span-12 md:col-span-7 md:col-start-4 xl:col-span-6 xl:col-start-4"],
  },
  closing: {
    className: "selected-work-sequence__beat--closing",
    layoutClasses: [
      "col-span-12 md:col-span-4 md:col-start-1 xl:col-span-4 xl:col-start-1",
      "col-span-12 md:col-span-7 md:col-start-6 md:mt-12 xl:col-span-7 xl:col-start-6 xl:mt-16",
    ],
  },
} as const;

const beatGroups = new Map<
  number,
  {
    order: number;
    template: ProjectHomepagePlacement["template"];
    items: SelectedWorkProject[];
  }
>();
let homepageProjectIndex = 0;
const priorityProjectCount = 2;

for (const project of projects) {
  const homepagePlacement = project.homepage;

  if (!homepagePlacement) {
    continue;
  }

  const existingBeat = beatGroups.get(homepagePlacement.order);

  if (existingBeat) {
    if (existingBeat.template !== homepagePlacement.template) {
      throw new Error(
        `Homepage beat ${homepagePlacement.order} has conflicting templates: ${existingBeat.template} and ${homepagePlacement.template}.`
      );
    }

    existingBeat.items.push(project);
    continue;
  }

  beatGroups.set(homepagePlacement.order, {
    order: homepagePlacement.order,
    template: homepagePlacement.template,
    items: [project],
  });
}

const resolvedBeats = Array.from(beatGroups.values())
  .sort((left, right) => left.order - right.order)
  .map((beat) => {
    const template = beatTemplates[beat.template];
    const items = [...beat.items]
      .sort(
        (left, right) =>
          (left.homepage?.slot ?? Number.MAX_SAFE_INTEGER) -
          (right.homepage?.slot ?? Number.MAX_SAFE_INTEGER)
      )
      .map((project, index) => {
        const priority = homepageProjectIndex < priorityProjectCount;
        homepageProjectIndex += 1;

        return {
          ...project,
          priority,
          layoutClass:
            template.layoutClasses[index] ?? template.layoutClasses[template.layoutClasses.length - 1],
        };
      });

    return {
      ...beat,
      className: template.className,
      items,
    };
  });
---

<section
  id="selected-work"
  class="selected-work-sequence"
  aria-label="Selected Works"
  data-project-cursor-scope="selected-work"
>
  <div class="selected-work-sequence__frame">
    <div class="selected-work-sequence__stack">
      {
        resolvedBeats.map((beat) => (
          <div class:list={["selected-work-sequence__beat", beat.className]}>
            {beat.items.map((project) => (
              <ProjectCard
                slug={project.slug}
                title={project.title}
                image={project.image}
                descriptor={project.descriptor}
                video={project.video}
                hoverPreview={project.hoverPreview}
                cursorInfo={project.cursorInfo}
                visualWeight={project.visualWeight}
                layoutClass={project.layoutClass}
                frameClass={projectFrameClasses[project.orientation ?? "landscape"]}
                frameStyle={
                  project.selectedWorkAspectRatio
                    ? `aspect-ratio: ${project.selectedWorkAspectRatio};`
                    : undefined
                }
                cropFocus={project.cropFocus}
                priority={project.priority}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  const revealTargets = Array.from(document.querySelectorAll("[data-project-reveal]"));

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    revealTargets.forEach((element) => {
      element.setAttribute("data-reveal-state", "visible");
    });
  } else if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.setAttribute("data-reveal-state", "visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.18,
        rootMargin: "0px 0px -8% 0px",
      }
    );

    revealTargets.forEach((element) => {
      if (element.getAttribute("data-reveal-state") === "visible") return;

      revealObserver.observe(element);
    });
  } else {
    revealTargets.forEach((element) => {
      element.setAttribute("data-reveal-state", "visible");
    });
  }
</script>

<style>
  .selected-work-sequence {
    padding: 1.5rem 1.5rem 8rem;
  }

  .selected-work-sequence__frame {
    max-width: 96rem;
    margin: 0 auto;
  }

  .selected-work-sequence__stack {
    display: grid;
    gap: 2.75rem;
  }

  .selected-work-sequence__beat {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .selected-work-sequence {
      padding: 2rem 2.5rem 10rem;
    }

    .selected-work-sequence__stack {
      gap: 5.5rem;
    }

    .selected-work-sequence__beat {
      column-gap: 2rem;
      row-gap: 1.8rem;
    }
  }

  @media (min-width: 80rem) {
    .selected-work-sequence {
      padding-inline: 3.5rem;
    }

    .selected-work-sequence__frame {
      max-width: 92rem;
    }

    .selected-work-sequence__stack {
      gap: clamp(6.5rem, 7vw, 8rem);
    }

    .selected-work-sequence__beat {
      column-gap: 3rem;
    }
  }
</style>
