---
interface Props {
  animateOnReveal?: boolean;
  fadeOnHover?: boolean;
}

const { animateOnReveal = false, fadeOnHover = false } = Astro.props;
---

<div
  class:list={[
    "persistent-monogram",
    animateOnReveal && "is-revealing",
    fadeOnHover && "is-hover-fading",
  ]}
  aria-hidden="true"
>
  <p class="persistent-monogram__marker">
    <span class="persistent-monogram__graphic">
      <span class="persistent-monogram__code">DO</span>
    </span>
  </p>
</div>

<style>
  .persistent-monogram {
    --persistent-marker-width: calc(var(--brand-marker-width) * 0.68);
    --persistent-marker-height: calc(var(--brand-marker-height) * 0.7);
    --persistent-marker-font-size: calc(var(--brand-marker-font-size) * 0.72);
    --persistent-marker-letter-spacing: calc(var(--brand-marker-letter-spacing) * 0.84);
    --persistent-marker-line-width: calc(var(--brand-marker-line-width) * 0.72);
    --persistent-marker-line-thickness: var(--brand-marker-line-thickness);
    --persistent-marker-line-gap: calc(var(--brand-marker-line-gap) * 0.82);
    position: fixed;
    right: var(--page-inline-offset);
    bottom: var(--brand-marker-bottom);
    z-index: 20;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .persistent-monogram__marker {
    width: var(--persistent-marker-width);
    height: var(--persistent-marker-height);
    box-sizing: border-box;
    margin: 0;
    display: block;
    opacity: 0.74;
    transition: opacity 220ms ease-out;
    pointer-events: auto;
    user-select: none;
  }

  .persistent-monogram__graphic {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding-bottom: calc(var(--persistent-marker-line-gap) + var(--persistent-marker-line-thickness) + 0.02rem);
    background: transparent;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: var(--persistent-marker-font-size);
    font-weight: 500;
    letter-spacing: var(--persistent-marker-letter-spacing);
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    font-kerning: none;
    font-variant-ligatures: none;
    font-variant-numeric: tabular-nums lining-nums;
    backface-visibility: hidden;
    text-rendering: geometricPrecision;
    transform: translateZ(0);
  }

  .persistent-monogram__graphic::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--persistent-marker-line-width);
    height: var(--persistent-marker-line-thickness);
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0.78) 18%,
      rgba(255, 255, 255, 0.78) 82%,
      rgba(255, 255, 255, 0)
    );
    transform: translateX(-50%);
    opacity: 0.96;
    pointer-events: none;
  }

  .persistent-monogram__code {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    transform: translate3d(0.02em, 0.004em, 0);
  }

  .persistent-monogram.is-revealing .persistent-monogram__marker {
    animation: persistent-marker-settle 760ms linear
      calc(var(--intro-image-settle-delay) + var(--intro-pre-swipe-duration)) forwards;
  }

  .persistent-monogram.is-hover-fading .persistent-monogram__marker:hover {
    opacity: 0;
  }

  @keyframes persistent-marker-settle {
    0% {
      opacity: 0.92;
    }

    100% {
      opacity: 0.74;
    }
  }
</style>
