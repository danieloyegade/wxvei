---
import ResponsiveImage from "./ResponsiveImage.astro";
import { projectPath } from "../lib/projects";
import { getResponsiveImageFallbackSrc } from "../lib/responsiveImages";
import { withBase } from "../lib/site";

interface SelectedWorkProject {
  slug: string;
  title: string;
  image: string;
  descriptor: string;
  href?: string;
  cursorInfo?: string[];
  orientation?: "portrait" | "landscape" | "wide";
  selectedWorkAspectRatio?: string;
  hoverPreview?: {
    src?: string;
    poster?: string;
    startTime: number;
    endTime?: number;
  };
  video?: {
    src: string;
    poster?: string;
    controls?: boolean;
    loop?: boolean;
    playInView?: boolean;
    videoFirst?: boolean;
    unmutedVolume?: number;
  };
  priority?: boolean;
}

interface Props {
  projects: SelectedWorkProject[];
}

const { projects } = Astro.props as Props;

const layoutVariants = ["lead", "left", "right", "center"] as const;

const getLayout = (index: number) => layoutVariants[index % layoutVariants.length];

const getSectionClasses = (index: number, project: SelectedWorkProject) => {
  const layout = getLayout(index);
  const isVideo = Boolean(project.video?.src);

  return [
    "selected-work-editorial__item",
    `selected-work-editorial__item--${layout}`,
    isVideo
      ? "selected-work-editorial__item--video"
      : "selected-work-editorial__item--image",
    index === 0 ? "selected-work-editorial__item--lead" : "",
  ]
    .filter(Boolean)
    .join(" ");
};

const getFigureClass = (index: number, project: SelectedWorkProject) => {
  const layout = getLayout(index);
  const isVideo = Boolean(project.video?.src);

  return [
    "selected-work-editorial__figure",
    `selected-work-editorial__figure--${layout}`,
    isVideo
      ? "selected-work-editorial__figure--video"
      : "selected-work-editorial__figure--image",
    index === 0 ? "selected-work-editorial__figure--lead" : "",
  ]
    .filter(Boolean)
    .join(" ");
};

const getCaptionClass = (index: number, project: SelectedWorkProject) => {
  const layout = getLayout(index);
  const isVideo = Boolean(project.video?.src);

  return [
    "selected-work-editorial__caption",
    `selected-work-editorial__caption--${layout}`,
    isVideo
      ? "selected-work-editorial__caption--video"
      : "selected-work-editorial__caption--image",
  ]
    .filter(Boolean)
    .join(" ");
};
---

<section
  id="selected-work"
  class="selected-work-editorial"
  aria-label="Selected Works"
  data-project-cursor-scope="selected-work"
>
  <div class="selected-work-editorial__shell">
    {
      projects.map((project, index) => {
        const isVideo = Boolean(project.video?.src);
        const previewVideoSrc = project.hoverPreview?.src ?? project.video?.src;
        const posterSrc = project.hoverPreview?.poster ?? project.video?.poster ?? project.image;
        const previewStartTime = project.hoverPreview?.startTime ?? 0;
        const previewEndTime = project.hoverPreview?.endTime ?? null;
        const figureClass = getFigureClass(index, project);
        const captionClass = getCaptionClass(index, project);
        const sectionClass = getSectionClasses(index, project);
        const cursorInfo = project.cursorInfo;

        return (
          <section
            class={sectionClass}
            data-work-reveal
            data-reveal-state="pending"
            data-media-kind={isVideo ? "video" : "image"}
            data-layout={getLayout(index)}
          >
            <figure class={figureClass}>
              <a
                class="selected-work-editorial__link"
                href={project.href ?? projectPath(project.slug)}
                aria-label={`View ${project.title}`}
                data-cursor-title={project.title}
                data-cursor-info={cursorInfo?.length ? JSON.stringify(cursorInfo) : undefined}
              >
                <div class="selected-work-editorial__media">
                  {isVideo ? (
                    <video
                      class="selected-work-editorial__video"
                      muted
                      playsinline
                      webkit-playsinline="true"
                      loop
                      preload="none"
                      poster={encodeURI(withBase(getResponsiveImageFallbackSrc(posterSrc)))}
                      aria-hidden="true"
                      data-selected-work-video
                      data-preview-in-view="true"
                      data-preview-start={previewStartTime}
                      data-preview-end={previewEndTime ?? undefined}
                    >
                      <source src={encodeURI(withBase(previewVideoSrc!))} type="video/mp4" />
                    </video>
                  ) : (
                    <ResponsiveImage
                      src={project.image}
                      alt={project.title}
                      class="selected-work-editorial__image"
                      sizes="(min-width: 80rem) 82vw, (min-width: 48rem) 78vw, 100vw"
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={project.priority ? "high" : undefined}
                    />
                  )}
                </div>
              </a>
              <figcaption class={captionClass}>
                <h2 class="selected-work-editorial__title">{project.title}</h2>
              </figcaption>
            </figure>
          </section>
        );
      })
    }
  </div>
</section>

<script is:inline>
  const motionTargets = Array.from(document.querySelectorAll("[data-work-reveal]"));
  const videoTargets = Array.from(document.querySelectorAll("[data-selected-work-video]"));
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const prefersReducedData = Boolean(navigator.connection?.saveData);

  const setPreviewTime = (video, startTime) => {
    if (!Number.isFinite(startTime) || video.readyState < 1) return;

    try {
      video.currentTime = startTime;
    } catch {
      // Ignore seek failures until the browser is ready.
    }
  };

  if (prefersReducedMotion.matches) {
    motionTargets.forEach((element) => {
      element.setAttribute("data-reveal-state", "visible");
    });
  } else if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.setAttribute("data-reveal-state", "visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.24,
        rootMargin: "0px 0px -12% 0px",
      }
    );

    motionTargets.forEach((element) => {
      revealObserver.observe(element);
    });
  } else {
    motionTargets.forEach((element) => {
      element.setAttribute("data-reveal-state", "visible");
    });
  }

  if (prefersReducedMotion.matches) {
    videoTargets.forEach((video) => {
      video.pause();
    });
  } else if ("IntersectionObserver" in window) {
    const handlePlaybackPromise = (playbackPromise) => {
      if (typeof playbackPromise?.catch === "function") {
        playbackPromise.catch(() => {});
      }
    };

    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target;

          if (!(video instanceof HTMLVideoElement)) return;

          const startTime = Number(video.dataset.previewStart ?? "0");
          const endTimeRaw = video.dataset.previewEnd;
          const endTime =
            endTimeRaw !== undefined && endTimeRaw !== "" ? Number(endTimeRaw) : null;
          const shouldPlay =
            entry.isIntersecting &&
            entry.intersectionRatio >= 0.25 &&
            !document.hidden &&
            !prefersReducedData;

          if (shouldPlay) {
            if (video.dataset.previewPrimed !== "true") {
              video.dataset.previewPrimed = "true";
              video.preload = "auto";
              video.load();
            }

            if (video.readyState < 1) {
              video.dataset.previewPlayPending = "true";
              return;
            }

            if (
              Number.isFinite(startTime) &&
              (video.currentTime < startTime || (Number.isFinite(endTime) && video.currentTime >= endTime))
            ) {
              setPreviewTime(video, startTime);
            }

            const playbackPromise = video.play();
            handlePlaybackPromise(playbackPromise);
            video.dataset.previewPlayPending = "false";
          } else {
            video.pause();
            video.dataset.previewPlayPending = "false";
          }
        });
      },
      {
        threshold: [0, 0.1, 0.25, 0.5, 0.75],
        rootMargin: "15% 0px 15% 0px",
      }
    );

    videoTargets.forEach((video) => {
      if (video instanceof HTMLVideoElement) {
        const startTime = Number(video.dataset.previewStart ?? "0");

        video.addEventListener("loadedmetadata", () => {
          setPreviewTime(video, startTime);
        });

        video.addEventListener("canplay", () => {
          if (video.dataset.previewPlayPending !== "true") return;

          video.dataset.previewPlayPending = "false";
          const playbackPromise = video.play();
          handlePlaybackPromise(playbackPromise);
        });

        video.addEventListener("playing", () => {
          video.dataset.previewPlayPending = "false";
        });

        videoObserver.observe(video);
      }
    });
  }
</script>

<style>
  .selected-work-editorial {
    padding: 1rem 1.25rem 6rem;
  }

  .selected-work-editorial__shell {
    max-width: 96rem;
    margin: 0 auto;
    display: grid;
    gap: clamp(1.5rem, 4vh, 3.5rem);
  }

  .selected-work-editorial__item {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: 86svh;
    align-items: center;
    padding-block: clamp(0.75rem, 2.25vh, 1.5rem);
  }

  .selected-work-editorial__figure {
    display: grid;
    gap: 0.8rem;
    min-width: 0;
    justify-items: center;
  }

  .selected-work-editorial__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .selected-work-editorial__link:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  .selected-work-editorial__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: 82vw;
    max-height: 72vh;
    opacity: 0;
    transform: translate3d(0, 0.95rem, 0) scale(0.985);
    transition:
      opacity 620ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .selected-work-editorial__caption {
    opacity: 0;
    transform: translate3d(0, 0.45rem, 0);
    transition:
      opacity 460ms cubic-bezier(0.22, 1, 0.36, 1) 140ms,
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1) 140ms;
  }

  .selected-work-editorial__item[data-reveal-state="visible"] .selected-work-editorial__media {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .selected-work-editorial__item[data-reveal-state="visible"] .selected-work-editorial__caption {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .selected-work-editorial__image,
  .selected-work-editorial__video {
    display: block;
    width: auto;
    height: auto;
    max-width: 82vw;
    max-height: 72vh;
    object-fit: contain;
  }

  .selected-work-editorial__media :global(.responsive-image) {
    display: block;
    width: auto;
    max-width: 82vw;
    max-height: 72vh;
  }

  .selected-work-editorial__media :global(.responsive-image img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 82vw;
    max-height: 72vh;
    object-fit: contain;
  }

  .selected-work-editorial__item--lead .selected-work-editorial__figure {
    gap: 0.9rem;
  }

  .selected-work-editorial__item--lead .selected-work-editorial__media {
    box-shadow: 0 1px 0 rgba(18, 16, 13, 0.03);
  }

  .selected-work-editorial__figure--lead {
    align-self: center;
  }

  .selected-work-editorial__item--lead .selected-work-editorial__figure,
  .selected-work-editorial__item--center .selected-work-editorial__figure {
    justify-self: center;
  }

  .selected-work-editorial__item--left .selected-work-editorial__figure {
    justify-self: start;
  }

  .selected-work-editorial__item--right .selected-work-editorial__figure {
    justify-self: end;
  }

  .selected-work-editorial__item--lead[data-media-kind="video"] .selected-work-editorial__figure {
    grid-column: 1 / span 12;
  }

  .selected-work-editorial__item--lead[data-media-kind="image"] .selected-work-editorial__figure {
    grid-column: 2 / span 10;
  }

  .selected-work-editorial__item--center[data-media-kind="video"] .selected-work-editorial__figure {
    grid-column: 2 / span 10;
  }

  .selected-work-editorial__item--center[data-media-kind="image"] .selected-work-editorial__figure {
    grid-column: 3 / span 8;
  }

  .selected-work-editorial__item--left[data-media-kind="video"] .selected-work-editorial__figure {
    grid-column: 1 / span 11;
  }

  .selected-work-editorial__item--left[data-media-kind="image"] .selected-work-editorial__figure {
    grid-column: 1 / span 8;
  }

  .selected-work-editorial__item--right[data-media-kind="video"] .selected-work-editorial__figure {
    grid-column: 2 / span 11;
  }

  .selected-work-editorial__item--right[data-media-kind="image"] .selected-work-editorial__figure {
    grid-column: 5 / span 8;
  }

  .selected-work-editorial__item--lead .selected-work-editorial__caption,
  .selected-work-editorial__item--center .selected-work-editorial__caption {
    justify-self: center;
    text-align: center;
  }

  .selected-work-editorial__item--left .selected-work-editorial__caption {
    justify-self: start;
    text-align: left;
  }

  .selected-work-editorial__item--right .selected-work-editorial__caption {
    justify-self: end;
    text-align: right;
  }

  .selected-work-editorial__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.02rem, 1vw + 0.45rem, 1.18rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .selected-work-editorial {
      padding: 1.25rem 2rem 7rem;
    }

    .selected-work-editorial__shell {
      gap: clamp(1.75rem, 4.5vh, 4rem);
    }

    .selected-work-editorial__item {
      min-height: 88svh;
    }
  }

  @media (min-width: 64rem) {
    .selected-work-editorial {
      padding-inline: 2.5rem;
    }

    .selected-work-editorial__shell {
      gap: clamp(2.25rem, 5vh, 4.5rem);
    }
  }

  @media (min-width: 80rem) {
    .selected-work-editorial {
      padding-inline: 3.25rem;
    }

    .selected-work-editorial__item {
      min-height: 90svh;
    }
  }

  @media (min-width: 48rem) {
    .selected-work-editorial {
      scroll-snap-type: y proximity;
    }

    .selected-work-editorial__item {
      scroll-snap-align: start;
    }
  }

  @media (max-width: 47.999rem) {
    .selected-work-editorial {
      padding-bottom: 5rem;
    }

    .selected-work-editorial__item {
      min-height: auto;
      padding-block: 0.6rem 1rem;
      grid-template-columns: 1fr;
    }

    .selected-work-editorial__figure,
    .selected-work-editorial__item--lead .selected-work-editorial__figure,
    .selected-work-editorial__item--center .selected-work-editorial__figure,
    .selected-work-editorial__item--left .selected-work-editorial__figure,
    .selected-work-editorial__item--right .selected-work-editorial__figure {
      grid-column: 1 / -1;
    }

    .selected-work-editorial__media {
      width: 100%;
    }

    .selected-work-editorial__image,
    .selected-work-editorial__video {
      max-height: none;
      width: 100%;
    }

    .selected-work-editorial__item--left .selected-work-editorial__caption,
    .selected-work-editorial__item--right .selected-work-editorial__caption,
    .selected-work-editorial__item--center .selected-work-editorial__caption,
    .selected-work-editorial__item--lead .selected-work-editorial__caption {
      justify-self: stretch;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selected-work-editorial__media,
    .selected-work-editorial__caption {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
