---
import { withBase } from "../lib/site";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const menuItems = [
  { label: "Selected Works", href: "/selected-work/" },
  { label: "Mixed Media", href: "/mixed-media/" },
  { label: "Portraiture", href: "/portraiture/" },
  { label: "Short Films", href: "/short-films/" },
  { label: "Blog", href: "/blog/" },
];

const matchesMenuPath = (currentPath: string, itemHref: string) => {
  if (itemHref === "/selected-work/") {
    return currentPath === "/" || currentPath === "/selected-work" || currentPath.startsWith("/selected-work/");
  }

  const normalizedHref = itemHref.endsWith("/") ? itemHref.slice(0, -1) : itemHref;

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};

const menuIsActive = menuItems.some(
  (item) => matchesMenuPath(pathname, item.href)
);
const menuId = "site-header-editorial-menu";
---

<div
  class:list={["header-menu", menuIsActive && "is-current"]}
  data-header-menu
  data-state="closed"
>
  <button
    class="header-menu__button"
    type="button"
    aria-expanded="false"
    aria-label="Open editorial menu"
    aria-controls={menuId}
  >
    <span class="header-menu__icon" aria-hidden="true">
      <span class="header-menu__line"></span>
      <span class="header-menu__line"></span>
      <span class="header-menu__line"></span>
    </span>
  </button>

  <nav
    id={menuId}
    class="header-menu__panel"
    aria-label="Editorial menu"
    aria-hidden="true"
    inert
  >
    <ul class="header-menu__list">
      {
        menuItems.map((item) => {
          const isCurrent = matchesMenuPath(pathname, item.href);

          return (
            <li class="header-menu__item">
              <a
                href={withBase(item.href)}
                class:list={["header-menu__link", isCurrent && "is-active"]}
                aria-current={isCurrent ? "page" : undefined}
                tabindex="-1"
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</div>

<script is:inline>
  const headerMenus = Array.from(document.querySelectorAll("[data-header-menu]"));

  headerMenus.forEach((menu) => {
    if (!(menu instanceof HTMLElement) || menu.dataset.enhanced === "true") return;

    menu.dataset.enhanced = "true";

    const button = menu.querySelector(".header-menu__button");
    const panel = menu.querySelector(".header-menu__panel");

    if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const links = Array.from(panel.querySelectorAll("a"));

    const setMenuState = (isOpen) => {
      menu.dataset.state = isOpen ? "open" : "closed";
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute(
        "aria-label",
        isOpen ? "Close editorial menu" : "Open editorial menu"
      );
      panel.setAttribute("aria-hidden", String(!isOpen));
      panel.inert = !isOpen;

      links.forEach((link) => {
        link.tabIndex = isOpen ? 0 : -1;
      });
    };

    setMenuState(false);

    button.addEventListener("click", () => {
      setMenuState(menu.dataset.state !== "open");
    });

    button.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" || menu.dataset.state === "open") return;

      event.preventDefault();
      setMenuState(true);
      links[0]?.focus();
    });

    panel.addEventListener("click", (event) => {
      if (!(event.target instanceof HTMLElement) || !event.target.closest("a")) return;

      setMenuState(false);
    });

    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;

      event.preventDefault();
      setMenuState(false);
      button.focus();
    });

    document.addEventListener("click", (event) => {
      if (menu.dataset.state !== "open") return;
      if (!(event.target instanceof Node) || menu.contains(event.target)) return;

      setMenuState(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menu.dataset.state !== "open") return;

      setMenuState(false);
      button.focus();
    });
  });
</script>

<style>
  .header-menu {
    position: relative;
    display: inline-flex;
    align-items: flex-end;
    justify-content: flex-end;
    color: #ffffff;
  }

  .header-menu__button {
    position: relative;
    display: inline-flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.76;
    transition: opacity 180ms ease-out;
  }

  .header-menu__button:hover,
  .header-menu.is-current .header-menu__button {
    opacity: 0.98;
  }

  .header-menu__button:focus-visible {
    outline: none;
    opacity: 0.98;
  }

  .header-menu__icon {
    position: relative;
    display: block;
    width: 1.1rem;
    height: 0.76rem;
    transform: translateY(-0.06rem);
  }

  .header-menu__line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform-origin: 50% 50%;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease-out;
  }

  .header-menu__line:nth-child(1) {
    top: 0;
  }

  .header-menu__line:nth-child(2) {
    top: calc(50% - 0.5px);
  }

  .header-menu__line:nth-child(3) {
    bottom: 0;
  }

  .header-menu[data-state="open"] .header-menu__line:nth-child(1) {
    transform: translate3d(0, 0.375rem, 0) rotate(45deg);
  }

  .header-menu[data-state="open"] .header-menu__line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.64);
  }

  .header-menu[data-state="open"] .header-menu__line:nth-child(3) {
    transform: translate3d(0, -0.375rem, 0) rotate(-45deg);
  }

  .header-menu__panel {
    position: absolute;
    top: calc(100% + 0.82rem);
    right: 0;
    width: max-content;
    max-width: min(16rem, calc(100vw - (var(--header-inline-padding, var(--page-inline-padding)) * 2)));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(0, -0.3rem, 0);
    transition:
      opacity 170ms ease-out,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 220ms;
  }

  .header-menu[data-state="open"] .header-menu__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
    transition-delay: 0s;
  }

  .header-menu__list {
    display: grid;
    justify-items: end;
    gap: 0.42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-menu__item {
    margin: 0;
  }

  .header-menu__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    color: inherit;
    font-family: var(--font-sans);
    font-size: clamp(0.84rem, 0.76rem + 0.16vw, 1rem);
    font-weight: 500;
    font-synthesis: weight;
    font-stretch: 112%;
    letter-spacing: 0.138em;
    line-height: 0.86;
    text-align: right;
    text-transform: uppercase;
    text-decoration: none;
    text-rendering: geometricPrecision;
    white-space: nowrap;
    opacity: 0.74;
    transition: opacity 160ms ease-out, text-decoration-color 160ms ease-out;
  }

  .header-menu__link:hover,
  .header-menu__link.is-active {
    opacity: 0.98;
  }

  .header-menu__link.is-active,
  .header-menu__link:focus-visible {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }

  .header-menu__link:focus-visible {
    outline: none;
  }

  @media (max-width: 40rem) {
    .header-menu__button {
      min-width: 2rem;
      min-height: 1.75rem;
      align-items: flex-start;
      justify-content: flex-end;
    }

    .header-menu__icon {
      width: 0.98rem;
      height: 0.68rem;
      transform: translateY(0.02rem);
    }

    .header-menu__panel {
      top: calc(100% + 0.72rem);
    }

    .header-menu__list {
      gap: 0.38rem;
    }

    .header-menu__link {
      font-size: 0.82rem;
      letter-spacing: 0.104em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-menu__button,
    .header-menu__line,
    .header-menu__panel,
    .header-menu__link {
      transition: none;
    }
  }
</style>
