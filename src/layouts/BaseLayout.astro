---
import "../styles/global.css";
import HeaderMenu from "../components/HeaderMenu.astro";
import { projectSectionConfigs } from "../data/editorial";
import { resolveProjectImageSrc, resolvePublishedAssetSrc } from "../lib/media";
import { getResponsiveImageFallbackSrc } from "../lib/responsiveImages";
import { withBase, withoutBase } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  preloadImage?: string;
  socialImage?: string;
  socialType?: "website" | "article";
}

const {
  title,
  description = "Daniel Oyegade is a minimal editorial portfolio built with Astro.",
  preloadImage,
  socialImage = preloadImage,
  socialType = "website",
} = Astro.props;
const satoshiRegularFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/satoshi-regular.woff2") ?? "/fonts/satoshi-regular.woff2"
);
const satoshiMediumFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/satoshi-medium.woff2") ?? "/fonts/satoshi-medium.woff2"
);
const cormorantRegularFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/cormorant-garamond-regular.ttf") ??
    "/fonts/cormorant-garamond-regular.ttf"
);
const cormorantMediumFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/cormorant-garamond-medium.ttf") ??
    "/fonts/cormorant-garamond-medium.ttf"
);
const satoshiRegularFontSrc = `url("${satoshiRegularFontUrl}") format("woff2")`;
const satoshiMediumFontSrc = `url("${satoshiMediumFontUrl}") format("woff2")`;
const cormorantRegularFontSrc = `url("${cormorantRegularFontUrl}") format("truetype")`;
const cormorantMediumFontSrc = `url("${cormorantMediumFontUrl}") format("truetype")`;
const faviconVersion = "do-20260325";
const resolveFaviconHref = (src: string) => {
  const resolvedSrc = resolvePublishedAssetSrc(src) ?? src;
  const href = withBase(resolvedSrc);
  const separator = href.includes("?") ? "&" : "?";

  return `${href}${separator}v=${faviconVersion}`;
};
const faviconSvgHref = resolveFaviconHref("/favicon.svg");
const favicon32Href = resolveFaviconHref("/favicon-32x32.png");
const favicon16Href = resolveFaviconHref("/favicon-16x16.png");
const appleTouchIconHref = resolveFaviconHref("/apple-touch-icon.png");
const pathname = withoutBase(Astro.url.pathname);
const isSectionPath = (basePath: string) => {
  const normalizedBasePath = basePath.endsWith("/") && basePath !== "/"
    ? basePath.slice(0, -1)
    : basePath;

  return (
    pathname === normalizedBasePath ||
    pathname === `${normalizedBasePath}/` ||
    pathname.startsWith(`${normalizedBasePath}/`)
  );
};
const headerSections = [
  { id: "selected-work", ...projectSectionConfigs["selected-work"] },
  { id: "portraiture", ...projectSectionConfigs.portraiture },
  { id: "mixed-media", ...projectSectionConfigs["mixed-media"] },
  { id: "short-films", ...projectSectionConfigs["short-films"] },
  { id: "blog", label: "Writing", path: "/blog/" },
] as const;
const activeHeaderSection =
  headerSections.find((section) =>
    section.id === "selected-work"
      ? pathname === "/" || isSectionPath(section.path)
      : section.id === "blog"
        ? pathname === "/blog" || pathname.startsWith("/blog/")
      : isSectionPath(section.path)
  ) ?? null;
const headerSectionLink = activeHeaderSection ?? headerSections[0];
const headerSectionOptions = headerSections.map((section) => ({
  id: section.id,
  label: section.label,
  path: withBase(section.path),
}));
const currentHeaderSectionId = activeHeaderSection?.id ?? "";
const isInformationPage = pathname.startsWith("/information");
const isBlogPage = pathname === "/blog" || pathname.startsWith("/blog/");
const headerSectionMemoryKey = "do:last-header-section";

const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
const canonicalHref = canonicalUrl.toString();
const currentOrigin = canonicalUrl.origin;
const getAssetOrigin = (src?: string) => {
  if (!src) {
    return null;
  }

  try {
    return new URL(src, Astro.site ?? Astro.url).origin;
  } catch {
    return null;
  }
};
const resolveMetaImageSrc = (src?: string) => {
  if (!src) {
    return undefined;
  }

  const responsiveSrc = getResponsiveImageFallbackSrc(src);

  return resolveProjectImageSrc(responsiveSrc) ?? resolvePublishedAssetSrc(responsiveSrc) ?? responsiveSrc;
};
const preloadImageHref = (() => {
  const resolvedImageSrc = resolveMetaImageSrc(preloadImage);

  return resolvedImageSrc ? withBase(resolvedImageSrc) : undefined;
})();
const socialImageHref = (() => {
  const resolvedImageSrc = resolveMetaImageSrc(socialImage);

  return resolvedImageSrc ? withBase(resolvedImageSrc) : undefined;
})();
const socialImageUrl = socialImageHref
  ? new URL(socialImageHref, Astro.site ?? Astro.url).toString()
  : undefined;
const twitterCard = socialImageUrl ? "summary_large_image" : "summary";
const preconnectOrigins = Array.from(
  new Set(
    [
      satoshiRegularFontUrl,
      satoshiMediumFontUrl,
      cormorantRegularFontUrl,
      cormorantMediumFontUrl,
      preloadImageHref,
      socialImageHref,
    ]
      .map(getAssetOrigin)
      .filter((origin): origin is string => Boolean(origin && origin !== currentOrigin))
  )
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalHref} />
    {preconnectOrigins.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}
    {preloadImageHref && <link rel="preload" as="image" href={preloadImageHref} />}
    <meta property="og:site_name" content="Daniel Oyegade" />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <link
      rel="icon"
      href={faviconSvgHref}
      sizes="any"
      type="image/svg+xml"
    />
    <link
      rel="icon"
      href={favicon32Href}
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="icon"
      href={favicon16Href}
      sizes="16x16"
      type="image/png"
    />
    <link
      rel="apple-touch-icon"
      href={appleTouchIconHref}
      sizes="180x180"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--page-background)] text-[var(--page-foreground)] antialiased">
    <div class="min-h-screen">
      <header class="site-header">
        <nav class="site-header__nav" aria-label="Primary">
          <div class="site-header__zone site-header__zone--left">
            <a
              href={withBase("/selected-work/")}
              class="site-header__link site-header__link--brand"
              aria-label="Daniel Oyegade"
            >
              Daniel Oyegade
            </a>
          </div>
          <div class="site-header__zone site-header__zone--center">
            <a
              href={withBase(headerSectionLink.path)}
              class:list={[
                "site-header__link site-header__link--work",
                activeHeaderSection && "is-active",
              ]}
              data-header-section-link
            >
              {headerSectionLink.label}
            </a>
          </div>
          <div class="site-header__zone site-header__zone--right">
            <a
              href={withBase("/information/")}
              class:list={[
                "site-header__link site-header__link--information",
                isInformationPage && "is-active",
              ]}
            >
              Information
            </a>
            <HeaderMenu pathname={pathname} />
          </div>
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
    </div>

    <div id="project-cursor" aria-hidden="true">
      <div class="project-cursor__title"></div>
      <div class="project-cursor__info"></div>
    </div>

    <script
      is:inline
      define:vars={{
        currentHeaderSectionId,
        headerSectionMemoryKey,
        headerSectionOptions,
        isBlogPage,
        isInformationPage,
      }}
    >
      const headerSectionLink = document.querySelector("[data-header-section-link]");

      if (headerSectionLink instanceof HTMLAnchorElement) {
        const headerSectionById = new Map(
          headerSectionOptions.map((section) => [section.id, section])
        );

        try {
          if (currentHeaderSectionId) {
            sessionStorage.setItem(headerSectionMemoryKey, currentHeaderSectionId);
          } else if (isInformationPage) {
            const rememberedSectionId = sessionStorage.getItem(headerSectionMemoryKey);
            const rememberedSection = rememberedSectionId
              ? headerSectionById.get(rememberedSectionId)
              : null;

            if (rememberedSection) {
              headerSectionLink.textContent = rememberedSection.label;
              headerSectionLink.href = rememberedSection.path;
            }
          }
        } catch {
          // Ignore storage access issues and keep the server-rendered fallback label.
        }
      }
    </script>

    <script is:inline>
      const cursorRoot = document.getElementById("project-cursor");
      const supportsCursor =
        window.matchMedia("(hover: hover)").matches &&
        window.matchMedia("(pointer: fine)").matches &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (cursorRoot instanceof HTMLElement && supportsCursor) {
        const titleNode = cursorRoot.querySelector(".project-cursor__title");
        const infoNode = cursorRoot.querySelector(".project-cursor__info");
        const cursorTargets = Array.from(
          document.querySelectorAll("[data-project-cursor-scope] [data-cursor-title]")
        ).filter((element) => element instanceof HTMLElement);

        if (titleNode instanceof HTMLElement && infoNode instanceof HTMLElement && cursorTargets.length > 0) {
          const body = document.body;
          let activeTarget = null;
          let mouseX = 0;
          let mouseY = 0;
          let currentX = 0;
          let currentY = 0;
          let rafId = 0;

          const parseCursorInfo = (value) => {
            if (!value) return [];

            try {
              const parsed = JSON.parse(value);

              if (Array.isArray(parsed)) {
                return parsed.map((line) => String(line).trim()).filter(Boolean);
              }
            } catch {
              // Fall back to pipe-delimited text below.
            }

            return value.split("|").map((line) => line.trim()).filter(Boolean);
          };

          const renderCursor = () => {
            if (!activeTarget) {
              rafId = 0;
              return;
            }

            currentX += (mouseX - currentX) * 0.22;
            currentY += (mouseY - currentY) * 0.22;
            cursorRoot.style.transform = `translate3d(${currentX + 18}px, ${currentY + 18}px, 0)`;

            if (Math.abs(mouseX - currentX) > 0.1 || Math.abs(mouseY - currentY) > 0.1) {
              rafId = window.requestAnimationFrame(renderCursor);
              return;
            }

            rafId = 0;
          };

          const startCursorAnimation = () => {
            if (!rafId) {
              rafId = window.requestAnimationFrame(renderCursor);
            }
          };

          const showCursor = () => {
            cursorRoot.classList.add("is-visible");
            body.classList.add("has-project-cursor");
          };

          const hideCursor = () => {
            activeTarget = null;
            cursorRoot.classList.remove("is-visible");
            body.classList.remove("has-project-cursor");

            if (rafId) {
              window.cancelAnimationFrame(rafId);
              rafId = 0;
            }
          };

          const setCursorContent = (target) => {
            const title = target.dataset.cursorTitle?.trim() ?? "";
            const info = parseCursorInfo(target.dataset.cursorInfo ?? "");

            titleNode.textContent = title;
            infoNode.textContent = info.join("\n");
            cursorRoot.classList.toggle("has-info", info.length > 0);
          };

          const activateCursor = (target, event) => {
            if (activeTarget === target) return;

            activeTarget = target;
            setCursorContent(target);
            mouseX = event.clientX;
            mouseY = event.clientY;
            currentX = mouseX;
            currentY = mouseY;
            cursorRoot.style.transform = `translate3d(${mouseX + 18}px, ${mouseY + 18}px, 0)`;
            showCursor();
            startCursorAnimation();
          };

          document.addEventListener("pointerover", (event) => {
            const target = event.target instanceof Element
              ? event.target.closest("[data-cursor-title]")
              : null;

            if (!(target instanceof HTMLElement)) return;

            activateCursor(target, event);
          });

          document.addEventListener("pointerout", (event) => {
            const target = event.target instanceof Element
              ? event.target.closest("[data-cursor-title]")
              : null;

            if (!(target instanceof HTMLElement) || target !== activeTarget) return;

            const relatedTarget = event.relatedTarget instanceof Element
              ? event.relatedTarget.closest("[data-cursor-title]")
              : null;

            if (relatedTarget instanceof HTMLElement && relatedTarget !== target) {
              activeTarget = relatedTarget;
              setCursorContent(relatedTarget);
              return;
            }

            hideCursor();
          });

          document.addEventListener("pointermove", (event) => {
            if (!activeTarget) return;

            mouseX = event.clientX;
            mouseY = event.clientY;
            startCursorAnimation();
          });

          document.addEventListener("pointerdown", () => {
            if (!activeTarget) return;

            hideCursor();
          });
        }
      }
    </script>
  </body>
</html>

<style
  is:global
  define:vars={{
    satoshiRegularFontSrc,
    satoshiMediumFontSrc,
    cormorantRegularFontSrc,
    cormorantMediumFontSrc,
  }}
>
  @font-face {
    font-family: "Satoshi";
    src: var(--satoshiRegularFontSrc);
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Satoshi";
    src: var(--satoshiMediumFontSrc);
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    src: var(--cormorantRegularFontSrc);
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    src: var(--cormorantMediumFontSrc);
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
</style>

<style>
  .site-header {
    --header-inline-padding: clamp(0.8rem, 1.1vw, 1.45rem);
    --header-block-start: clamp(0.42rem, 0.78vw, 0.82rem);
    --header-block-end: clamp(0.78rem, 0.92vw, 1rem);
    --header-column-gap: clamp(1.4rem, 2.8vw, 3.6rem);
    --header-right-gap: clamp(1rem, 1.4vw, 1.7rem);
    --header-link-size: clamp(1.12rem, 0.9rem + 0.48vw, 1.72rem);
    --header-letter-spacing: 0.158em;
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .site-header__nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--header-column-gap);
    width: 100%;
    margin: 0 auto;
    min-height: var(--header-clearance);
    padding: var(--header-block-start) var(--header-inline-padding) var(--header-block-end);
    pointer-events: auto;
  }

  .site-header__zone {
    min-width: 0;
    display: flex;
    align-items: baseline;
  }

  .site-header__zone--left {
    justify-content: flex-start;
  }

  .site-header__zone--center {
    justify-content: center;
  }

  .site-header__zone--right {
    justify-content: flex-end;
    gap: var(--header-right-gap);
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: var(--header-link-size);
    font-weight: 500;
    font-synthesis: weight;
    font-stretch: 112%;
    letter-spacing: var(--header-letter-spacing);
    line-height: 0.82;
    text-transform: uppercase;
    white-space: nowrap;
    font-kerning: none;
    font-variant-ligatures: none;
    text-rendering: geometricPrecision;
    text-decoration-color: currentColor;
    text-decoration-line: none;
    text-decoration-skip-ink: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 160ms ease-out, text-decoration-color 160ms ease-out;
    opacity: 0.74;
  }

  .site-header__link:hover {
    opacity: 0.9;
  }

  .site-header__link--brand,
  .site-header__link.is-active {
    opacity: 0.98;
  }

  .site-header__link.is-active {
    text-decoration-line: underline;
  }

  .site-header__link--brand {
    letter-spacing: var(--header-letter-spacing);
  }

  .site-header__link--work {
    min-width: 13.6ch;
    justify-content: center;
    text-align: center;
  }

  .site-header__link--information {
    letter-spacing: var(--header-letter-spacing);
  }

  .site-main {
    padding-top: var(--header-clearance);
  }

  @media (max-width: 40rem) {
    .site-header {
      --header-inline-padding: clamp(1rem, 4.5vw, 1.28rem);
      --header-block-start: 0.66rem;
      --header-block-end: 0.88rem;
      --header-column-gap: 0.75rem;
      --header-right-gap: 0;
      --header-link-size: 0.84rem;
      --header-letter-spacing: 0.1em;
    }

    .site-header__nav {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand menu"
        "title title";
      row-gap: 0.5rem;
      width: 100%;
      align-items: start;
    }

    .site-header__zone {
      align-items: flex-start;
    }

    .site-header__zone--left {
      grid-area: brand;
      justify-self: start;
      padding-right: 0.5rem;
    }

    .site-header__zone--center {
      grid-area: title;
      justify-self: stretch;
      justify-content: center;
      padding-inline: clamp(2.4rem, 12vw, 3.8rem);
    }

    .site-header__zone--right {
      grid-area: menu;
      justify-self: end;
    }

    .site-header__link {
      line-height: 0.9;
    }

    .site-header__link--work {
      min-width: 0;
      font-size: 0.8rem;
      letter-spacing: 0.114em;
    }

    .site-header__link--brand {
      font-size: 0.76rem;
      letter-spacing: 0.088em;
    }

    .site-header__link--information {
      display: none;
    }

    .site-main {
      padding-top: clamp(6rem, 20vw, 6.8rem);
    }
  }
</style>
