---
import "../styles/global.css";
import HeaderMenu from "../components/HeaderMenu.astro";
import { projectSectionConfigs } from "../data/projectSections";
import { resolvePublishedAssetSrc } from "../lib/media";
import { withBase, withoutBase } from "../lib/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Daniel Oyegade is a minimal editorial portfolio built with Astro.",
} = Astro.props;
const satoshiRegularFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/satoshi-regular.woff2") ?? "/fonts/satoshi-regular.woff2"
);
const satoshiMediumFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/satoshi-medium.woff2") ?? "/fonts/satoshi-medium.woff2"
);
const cormorantRegularFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/cormorant-garamond-regular.ttf") ??
    "/fonts/cormorant-garamond-regular.ttf"
);
const cormorantMediumFontUrl = withBase(
  resolvePublishedAssetSrc("/fonts/cormorant-garamond-medium.ttf") ??
    "/fonts/cormorant-garamond-medium.ttf"
);
const satoshiRegularFontSrc = `url("${satoshiRegularFontUrl}") format("woff2")`;
const satoshiMediumFontSrc = `url("${satoshiMediumFontUrl}") format("woff2")`;
const cormorantRegularFontSrc = `url("${cormorantRegularFontUrl}") format("truetype")`;
const cormorantMediumFontSrc = `url("${cormorantMediumFontUrl}") format("truetype")`;
const faviconVersion = "do-20260325";
const resolveFaviconHref = (src: string) => {
  const resolvedSrc = import.meta.env.DEV ? src : resolvePublishedAssetSrc(src) ?? src;
  const href = withBase(resolvedSrc);
  const separator = href.includes("?") ? "&" : "?";

  return `${href}${separator}v=${faviconVersion}`;
};
const faviconIcoHref = resolveFaviconHref("/favicon.ico");
const faviconSvgHref = resolveFaviconHref("/favicon.svg");
const favicon32Href = resolveFaviconHref("/favicon-32x32.png");
const favicon16Href = resolveFaviconHref("/favicon-16x16.png");
const appleTouchIconHref = resolveFaviconHref("/apple-touch-icon.png");
const pathname = withoutBase(Astro.url.pathname);
const isSectionPath = (basePath: string) => {
  const normalizedBasePath = basePath.endsWith("/") && basePath !== "/"
    ? basePath.slice(0, -1)
    : basePath;

  return (
    pathname === normalizedBasePath ||
    pathname === `${normalizedBasePath}/` ||
    pathname.startsWith(`${normalizedBasePath}/`)
  );
};
const headerSections = [
  { id: "selected-work", ...projectSectionConfigs["selected-work"] },
  { id: "portraiture", ...projectSectionConfigs.portraiture },
  { id: "mixed-media", ...projectSectionConfigs["mixed-media"] },
  { id: "short-films", ...projectSectionConfigs["short-films"] },
] as const;
const activeHeaderSection =
  headerSections.find((section) =>
    section.id === "selected-work"
      ? pathname === "/" || isSectionPath(section.path)
      : isSectionPath(section.path)
  ) ?? null;
const headerSectionLink = activeHeaderSection ?? headerSections[0];
const isInformationPage = pathname.startsWith("/information");

const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="shortcut icon" href={faviconIcoHref} sizes="any" type="image/x-icon" />
    <link
      rel="icon"
      href={faviconSvgHref}
      sizes="any"
      type="image/svg+xml"
    />
    <link
      rel="icon"
      href={favicon32Href}
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="icon"
      href={favicon16Href}
      sizes="16x16"
      type="image/png"
    />
    <link
      rel="apple-touch-icon"
      href={appleTouchIconHref}
      sizes="180x180"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--page-background)] text-[var(--page-foreground)] antialiased">
    <div class="min-h-screen">
      <header class="site-header">
        <nav class="site-header__nav" aria-label="Primary">
          <div class="site-header__zone site-header__zone--left">
            <span
              class="site-header__link site-header__link--brand"
              aria-label="Daniel Oyegade"
            >
              Daniel Oyegade
            </span>
          </div>
          <div class="site-header__zone site-header__zone--center">
            <a
              href={withBase(headerSectionLink.path)}
              class:list={[
                "site-header__link site-header__link--work",
                activeHeaderSection && "is-active",
              ]}
            >
              {headerSectionLink.label}
            </a>
          </div>
          <div class="site-header__zone site-header__zone--right">
            <a
              href={withBase("/information/")}
              class:list={[
                "site-header__link site-header__link--information",
                isInformationPage && "is-active",
              ]}
            >
              Information
            </a>
            <HeaderMenu pathname={pathname} />
          </div>
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style
  is:global
  define:vars={{
    satoshiRegularFontSrc,
    satoshiMediumFontSrc,
    cormorantRegularFontSrc,
    cormorantMediumFontSrc,
  }}
>
  @font-face {
    font-family: "Satoshi";
    src: var(--satoshiRegularFontSrc);
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Satoshi";
    src: var(--satoshiMediumFontSrc);
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    src: var(--cormorantRegularFontSrc);
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    src: var(--cormorantMediumFontSrc);
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
</style>

<style>
  .site-header {
    --header-inline-padding: clamp(0.8rem, 1.1vw, 1.45rem);
    --header-block-start: clamp(0.42rem, 0.78vw, 0.82rem);
    --header-block-end: clamp(0.78rem, 0.92vw, 1rem);
    --header-column-gap: clamp(1.4rem, 2.8vw, 3.6rem);
    --header-right-gap: clamp(1rem, 1.4vw, 1.7rem);
    --header-link-size: clamp(1.12rem, 0.9rem + 0.48vw, 1.72rem);
    --header-letter-spacing: 0.158em;
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .site-header__nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--header-column-gap);
    width: 100%;
    margin: 0 auto;
    min-height: var(--header-clearance);
    padding: var(--header-block-start) var(--header-inline-padding) var(--header-block-end);
    pointer-events: auto;
  }

  .site-header__zone {
    min-width: 0;
    display: flex;
    align-items: baseline;
  }

  .site-header__zone--left {
    justify-content: flex-start;
  }

  .site-header__zone--center {
    justify-content: center;
  }

  .site-header__zone--right {
    justify-content: flex-end;
    gap: var(--header-right-gap);
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: var(--header-link-size);
    font-weight: 500;
    font-synthesis: weight;
    font-stretch: 112%;
    letter-spacing: var(--header-letter-spacing);
    line-height: 0.82;
    text-transform: uppercase;
    white-space: nowrap;
    font-kerning: none;
    font-variant-ligatures: none;
    text-rendering: geometricPrecision;
    text-decoration-color: currentColor;
    text-decoration-line: none;
    text-decoration-skip-ink: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 160ms ease-out, text-decoration-color 160ms ease-out;
    opacity: 0.74;
  }

  .site-header__link:hover {
    opacity: 0.9;
  }

  .site-header__link--brand,
  .site-header__link.is-active {
    opacity: 0.98;
  }

  .site-header__link.is-active {
    text-decoration-line: underline;
  }

  .site-header__link--brand {
    letter-spacing: var(--header-letter-spacing);
  }

  .site-header__link--work {
    min-width: 13.6ch;
    justify-content: center;
    text-align: center;
  }

  .site-header__link--information {
    letter-spacing: var(--header-letter-spacing);
  }

  .site-main {
    padding-top: var(--header-clearance);
  }

  @media (max-width: 40rem) {
    .site-header {
      --header-inline-padding: clamp(1rem, 4.5vw, 1.28rem);
      --header-block-start: 0.66rem;
      --header-block-end: 0.88rem;
      --header-column-gap: 0.75rem;
      --header-right-gap: 0;
      --header-link-size: 0.84rem;
      --header-letter-spacing: 0.1em;
    }

    .site-header__nav {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand menu"
        "title title";
      row-gap: 0.5rem;
      width: 100%;
      align-items: start;
    }

    .site-header__zone {
      align-items: flex-start;
    }

    .site-header__zone--left {
      grid-area: brand;
      justify-self: start;
      padding-right: 0.5rem;
    }

    .site-header__zone--center {
      grid-area: title;
      justify-self: stretch;
      justify-content: center;
      padding-inline: clamp(2.4rem, 12vw, 3.8rem);
    }

    .site-header__zone--right {
      grid-area: menu;
      justify-self: end;
    }

    .site-header__link {
      line-height: 0.9;
    }

    .site-header__link--work {
      min-width: 0;
      font-size: 0.8rem;
      letter-spacing: 0.114em;
    }

    .site-header__link--brand {
      font-size: 0.76rem;
      letter-spacing: 0.088em;
    }

    .site-header__link--information {
      display: none;
    }

    .site-main {
      padding-top: clamp(6rem, 20vw, 6.8rem);
    }
  }
</style>
