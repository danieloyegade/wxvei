---
import "../styles/global.css";
import HeaderMenu from "../components/HeaderMenu.astro";
import { withBase, withoutBase } from "../lib/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Daniel Oyegade is a minimal editorial portfolio built with Astro.",
} = Astro.props;
const satoshiRegularFontUrl = withBase("/fonts/satoshi-regular.woff2");
const satoshiMediumFontUrl = withBase("/fonts/satoshi-medium.woff2");
const cormorantRegularFontUrl = withBase("/fonts/cormorant-garamond-regular.ttf");
const cormorantMediumFontUrl = withBase("/fonts/cormorant-garamond-medium.ttf");
const satoshiRegularFontSrc = `url("${satoshiRegularFontUrl}") format("woff2")`;
const satoshiMediumFontSrc = `url("${satoshiMediumFontUrl}") format("woff2")`;
const cormorantRegularFontSrc = `url("${cormorantRegularFontUrl}") format("truetype")`;
const cormorantMediumFontSrc = `url("${cormorantMediumFontUrl}") format("truetype")`;
const pathname = withoutBase(Astro.url.pathname);
const isSectionPath = (basePath: string) =>
  pathname === basePath || pathname === `${basePath}/` || pathname.startsWith(`${basePath}/`);
const isSelectedWorkPage =
  pathname === "/" ||
  isSectionPath("/selected-work");
const isInformationPage = pathname.startsWith("/information");

const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("/favicon-32x32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={withBase("/favicon-16x16.png")} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--page-background)] text-[var(--page-foreground)] antialiased">
    <div class="min-h-screen">
      <header class="site-header">
        <nav class="site-header__nav" aria-label="Primary">
          <div class="site-header__zone site-header__zone--left">
            <span
              class="site-header__link site-header__link--brand"
              aria-label="Daniel Oyegade"
            >
              Daniel Oyegade
            </span>
          </div>
          <div class="site-header__zone site-header__zone--center">
            <a
              href={withBase("/selected-work/")}
              class:list={[
                "site-header__link site-header__link--work",
                isSelectedWorkPage && "is-active",
              ]}
            >
              Selected Works
            </a>
          </div>
          <div class="site-header__zone site-header__zone--right">
            <a
              href={withBase("/information/")}
              class:list={[
                "site-header__link site-header__link--information",
                isInformationPage && "is-active",
              ]}
            >
              Information
            </a>
            <HeaderMenu pathname={pathname} />
          </div>
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style
  is:global
  define:vars={{
    satoshiRegularFontSrc,
    satoshiMediumFontSrc,
    cormorantRegularFontSrc,
    cormorantMediumFontSrc,
  }}
>
  @font-face {
    font-family: "Satoshi";
    src: var(--satoshiRegularFontSrc);
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Satoshi";
    src: var(--satoshiMediumFontSrc);
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    src: var(--cormorantRegularFontSrc);
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    src: var(--cormorantMediumFontSrc);
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
</style>

<style>
  .site-header {
    --header-inline-padding: clamp(0.8rem, 1.1vw, 1.45rem);
    --header-block-start: clamp(0.42rem, 0.78vw, 0.82rem);
    --header-block-end: clamp(0.78rem, 0.92vw, 1rem);
    --header-column-gap: clamp(1.4rem, 2.8vw, 3.6rem);
    --header-right-gap: clamp(1rem, 1.4vw, 1.7rem);
    --header-link-size: clamp(1.12rem, 0.9rem + 0.48vw, 1.72rem);
    --header-letter-spacing: 0.158em;
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .site-header__nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--header-column-gap);
    width: 100%;
    margin: 0 auto;
    min-height: var(--header-clearance);
    padding: var(--header-block-start) var(--header-inline-padding) var(--header-block-end);
    pointer-events: auto;
  }

  .site-header__zone {
    min-width: 0;
    display: flex;
    align-items: baseline;
  }

  .site-header__zone--left {
    justify-content: flex-start;
  }

  .site-header__zone--center {
    justify-content: center;
  }

  .site-header__zone--right {
    justify-content: flex-end;
    gap: var(--header-right-gap);
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: var(--header-link-size);
    font-weight: 500;
    font-synthesis: weight;
    font-stretch: 112%;
    letter-spacing: var(--header-letter-spacing);
    line-height: 0.82;
    text-transform: uppercase;
    white-space: nowrap;
    font-kerning: none;
    font-variant-ligatures: none;
    text-rendering: geometricPrecision;
    text-decoration-color: currentColor;
    text-decoration-line: none;
    text-decoration-skip-ink: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: opacity 160ms ease-out, text-decoration-color 160ms ease-out;
    opacity: 0.74;
  }

  .site-header__link:hover {
    opacity: 0.9;
  }

  .site-header__link--brand,
  .site-header__link.is-active {
    opacity: 0.98;
  }

  .site-header__link.is-active {
    text-decoration-line: underline;
  }

  .site-header__link--brand {
    letter-spacing: var(--header-letter-spacing);
  }

  .site-header__link--work {
    min-width: 13.6ch;
    justify-content: center;
    text-align: center;
  }

  .site-header__link--information {
    letter-spacing: var(--header-letter-spacing);
  }

  .site-main {
    padding-top: var(--header-clearance);
  }

  @media (max-width: 40rem) {
    .site-header {
      --header-inline-padding: clamp(0.68rem, 3vw, 0.94rem);
      --header-block-start: 0.42rem;
      --header-block-end: 0.72rem;
      --header-column-gap: 0.78rem;
      --header-right-gap: 0.58rem;
      --header-link-size: 0.98rem;
      --header-letter-spacing: 0.13em;
    }

    .site-header__nav {
      width: 100%;
    }

    .site-header__link--work {
      min-width: auto;
    }

    .site-header__link--information {
      display: none;
    }
  }
</style>
