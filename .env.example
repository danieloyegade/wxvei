# Media source switches:
# - local: use files from this repo's public/ directory
# - remote: resolve matching paths against Cloudflare R2 or another media host
PUBLIC_IMAGE_SOURCE=local
PUBLIC_VIDEO_SOURCE=local

# Optional shared base URL for published image and video assets.
# Example: https://media.example.com
PUBLIC_MEDIA_BASE_URL=

# Optional video-specific override. When PUBLIC_VIDEO_SOURCE=remote, any video
# path under /projects/.../videos/ is resolved against this base URL first.
# Leave this empty to fall back to PUBLIC_MEDIA_BASE_URL.
PUBLIC_PROJECT_VIDEO_BASE_URL=
