# Media source switches:
# - PUBLIC_ASSET_SOURCE is the shared default for published assets like
#   favicons, fonts, site photos, and project images
# - local: use files from this repo's public/ directory
# - remote: resolve matching paths against Cloudflare R2 or another media host
# - in production, set these same names as GitHub Actions variables for the
#   repository or the `github-pages` environment
PUBLIC_ASSET_SOURCE=local

# Optional per-type overrides. Leave these empty to inherit PUBLIC_ASSET_SOURCE.
PUBLIC_IMAGE_SOURCE=
PUBLIC_VIDEO_SOURCE=

# Optional shared base URL for published image and video assets.
# Example: https://media.example.com
PUBLIC_MEDIA_BASE_URL=

# Optional video-specific override. When PUBLIC_VIDEO_SOURCE=remote, any video
# path under /projects/.../videos/ is resolved against this base URL first.
# Leave this empty to fall back to PUBLIC_MEDIA_BASE_URL.
PUBLIC_PROJECT_VIDEO_BASE_URL=

# Typical production video-only setup:
# PUBLIC_VIDEO_SOURCE=remote
# PUBLIC_PROJECT_VIDEO_BASE_URL=https://media.danieloye.com
